---
import DirectoryLayout from "../layouts/DirectoryLayout.astro";
import { siteConfig } from "../config/site";
import { categories } from "../config/categories";
import { platforms } from "../config/platforms";
import { ENABLED_COUNTRIES } from "../config/countries";

const pageTitle = `Submit a Job Community | ${siteConfig.name}`;
const pageDescription = "Submit a public Discord server, Telegram channel, or WhatsApp group sharing job alerts and career opportunities.";
---

<DirectoryLayout
  heading="Submit a Job Alert Community"
  subheading="Submit a publicly accessible community or job channel for automated verification and manual review."
  breadcrumbs={[{ name: "Submit Group", item: "/submit/" }]}
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/submit/"
  noindex={true}
  pageType="utility"
>
  <div class="max-w-2xl mx-auto">
    <!-- Submission Guidelines Box -->
    <div class="mb-8 neo-card-mint p-6 text-xs text-black font-bold space-y-2">
      <strong class="font-black text-black block text-sm uppercase tracking-wide">
        Submission Policy & Review Criteria
      </strong>
      <ul class="list-disc pl-4 space-y-1.5 text-black">
        <li><strong>English-Speaking Target Markets:</strong> Priority focus on the United States, United Kingdom, Canada, and Australia.</li>
        <li><strong>Zero Tolerance for Job Scams:</strong> Task scams, upfront fee requests, crypto/USDT deposits, and fake check schemes are permanently banned.</li>
        <li><strong>Public Communities Only:</strong> Do not submit private paid masterminds or password-protected resources.</li>
        <li><strong>Confidential Admin Contact:</strong> Any admin email provided is kept strictly private and never exposed publicly.</li>
      </ul>
    </div>

    <!-- Netlify Form -->
    <form
      name="community-submission"
      method="POST"
      action="/submit-success/"
      data-netlify="true"
      netlify-honeypot="bot-field"
      class="rounded-3xl border-[3px] border-black bg-white p-6 sm:p-8 shadow-[6px_6px_0px_0px_#000] space-y-6"
    >
      <input type="hidden" name="form-name" value="community-submission" />

      <!-- Honeypot for bot spam prevention -->
      <p class="hidden">
        <label>
          Don't fill this out if you're human: <input name="bot-field" />
        </label>
      </p>

      <!-- Community Title -->
      <div>
        <label for="title" class="block text-xs font-black uppercase tracking-wider text-black mb-1.5">
          Community Name <span class="text-rose-600">*</span>
        </label>
        <input
          type="text"
          name="title"
          id="title"
          required
          placeholder="e.g. Canada Tech Jobs & Hiring Hub"
          class="w-full rounded-xl border-2 border-black py-2.5 px-4 text-sm font-medium text-black placeholder:text-slate-400 shadow-[2px_2px_0px_0px_#000] focus:outline-none focus:shadow-[4px_4px_0px_0px_#000]"
        />
      </div>

      <!-- Public Invite URL -->
      <div>
        <label for="inviteUrl" class="block text-xs font-black uppercase tracking-wider text-black mb-1.5">
          Public Invite URL <span class="text-rose-600">*</span>
        </label>
        <input
          type="url"
          name="inviteUrl"
          id="inviteUrl"
          required
          placeholder="https://discord.gg/..., https://t.me/..., or https://chat.whatsapp.com/..."
          class="w-full rounded-xl border-2 border-black py-2.5 px-4 text-sm font-medium text-black placeholder:text-slate-400 shadow-[2px_2px_0px_0px_#000] focus:outline-none focus:shadow-[4px_4px_0px_0px_#000]"
        />
        <p class="mt-1 text-[11px] font-bold text-slate-600">
          Must be a standard public Discord invite, Telegram channel link, or WhatsApp group invite.
        </p>
      </div>

      <!-- Platform & Category Row -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="platform" class="block text-xs font-black uppercase tracking-wider text-black mb-1.5">
            Platform <span class="text-rose-600">*</span>
          </label>
          <select
            name="platform"
            id="platform"
            required
            class="w-full rounded-xl border-2 border-black bg-[#FAF8F5] py-2.5 px-4 text-xs font-bold text-black shadow-[2px_2px_0px_0px_#000] focus:bg-white focus:outline-none"
          >
            {platforms.filter(p => p.isConfigured).map((p) => (
              <option value={p.id}>{p.name}</option>
            ))}
          </select>
        </div>

        <div>
          <label for="category" class="block text-xs font-black uppercase tracking-wider text-black mb-1.5">
            Category <span class="text-rose-600">*</span>
          </label>
          <select
            name="category"
            id="category"
            required
            class="w-full rounded-xl border-2 border-black bg-[#FAF8F5] py-2.5 px-4 text-xs font-bold text-black shadow-[2px_2px_0px_0px_#000] focus:bg-white focus:outline-none"
          >
            {categories.map((c) => (
              <option value={c.slug}>{c.name}</option>
            ))}
          </select>
        </div>
      </div>

      <!-- Target Country -->
      <div>
        <label for="countryCode" class="block text-xs font-black uppercase tracking-wider text-black mb-1.5">
          Target Country <span class="text-rose-600">*</span>
        </label>
        <select
          name="countryCode"
          id="countryCode"
          required
          class="w-full rounded-xl border-2 border-black bg-[#FAF8F5] py-2.5 px-4 text-xs font-bold text-black shadow-[2px_2px_0px_0px_#000] focus:bg-white focus:outline-none"
        >
          {ENABLED_COUNTRIES.map((c) => (
            <option value={c.code}>{c.name}</option>
          ))}
        </select>
      </div>

      <!-- Description -->
      <div>
        <label for="description" class="block text-xs font-black uppercase tracking-wider text-black mb-1.5">
          Description
        </label>
        <textarea
          name="description"
          id="description"
          rows="3"
          placeholder="Brief description of the job alerts, industries, or opportunities shared in this group..."
          class="w-full rounded-xl border-2 border-black py-2.5 px-4 text-sm font-medium text-black placeholder:text-slate-400 shadow-[2px_2px_0px_0px_#000] focus:outline-none focus:shadow-[4px_4px_0px_0px_#000]"
        ></textarea>
      </div>

      <!-- Admin Email (Private) -->
      <div>
        <label for="submitterEmail" class="block text-xs font-black uppercase tracking-wider text-black mb-1.5">
          Your Email (Optional, Strictly Private)
        </label>
        <input
          type="email"
          name="submitterEmail"
          id="submitterEmail"
          placeholder="admin@example.com"
          class="w-full rounded-xl border-2 border-black py-2.5 px-4 text-sm font-medium text-black placeholder:text-slate-400 shadow-[2px_2px_0px_0px_#000] focus:outline-none focus:shadow-[4px_4px_0px_0px_#000]"
        />
        <p class="mt-1 text-[11px] font-bold text-slate-600">
          Used only if maintainers need to clarify listing ownership. Never exposed publicly.
        </p>
      </div>

      <!-- Submit Button -->
      <div>
        <button
          type="submit"
          class="neo-button w-full bg-[#A7F3D0] hover:bg-[#6EE7B7] text-black py-3 px-6 text-sm font-black"
        >
          Submit Community for Review &rarr;
        </button>
      </div>
    </form>
  </div>
</DirectoryLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { categories } from "../config/categories";
import { ENABLED_COUNTRIES } from "../config/countries";
import { platforms } from "../config/platforms";
import { generateBreadcrumbSchema } from "../lib/schema";

const breadcrumbs = [
  { name: "All Jobs", item: "/jobs" },
  { name: "Submit Job Community", item: "/submit" },
];

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs);
---

<BaseLayout
  title="Submit a Job Alert Group"
  description="Submit a public Telegram job channel, Discord career server, or WhatsApp job group to be catalogued in the directory."
  canonicalPath="/submit"
  jsonLd={breadcrumbSchema}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <Breadcrumbs items={breadcrumbs} />

    <div class="mb-8 p-6 sm:p-8 rounded-3xl border-[3px] border-black bg-[#FEF08A] shadow-[5px_5px_0px_0px_#000]">
      <div class="inline-block bg-white px-2 py-0.5 border-2 border-black text-[10px] font-black uppercase tracking-wider shadow-[1.5px_1.5px_0px_0px_#000] mb-2">
        JOB COMMUNITY SUBMISSIONS
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-black tracking-tight">
        Submit a Job Alert Group
      </h1>
      <p class="mt-2 text-sm font-bold text-black/80 leading-relaxed">
        Suggest a publicly discoverable job alert community. Every submission is reviewed to ensure link validity, career focus, and complete absence of job scams or fee requirements.
      </p>
    </div>

    <!-- Submission Guidelines Box -->
    <div class="mb-8 neo-card-mint p-6 text-xs text-black font-bold space-y-2">
      <strong class="font-black text-black block text-sm uppercase tracking-wide">?? Submission Policy & Review Criteria</strong>
      <ul class="list-disc pl-4 space-y-1.5 text-black">
        <li><strong>Premium English-Speaking Markets:</strong> Priority focus on the United States, United Kingdom, Canada, and Australia.</li>
        <li><strong>Zero Tolerance for Job Scams:</strong> Task scams, upfront fee requests, crypto/USDT deposits, and fake check schemes are permanently banned.</li>
        <li><strong>Public Communities Only:</strong> Do not submit private paid masterminds or password-protected resources.</li>
        <li><strong>Confidential Admin Contact:</strong> Any admin email provided is kept strictly private and never exposed publicly.</li>
      </ul>
    </div>

    <!-- Netlify Form -->
    <form
      name="job-community-submission"
      method="POST"
      action="/submit-success"
      data-netlify="true"
      netlify-honeypot="bot-field"
      class="rounded-3xl border-[3px] border-black bg-white p-6 sm:p-8 shadow-[6px_6px_0px_0px_#000] space-y-6"
    >
      <!-- Hidden Netlify Form identification -->
      <input type="hidden" name="form-name" value="job-community-submission" />

      <!-- Honeypot Field for anti-bot protection -->
      <p class="hidden">
        <label>
          Don’t fill this out if you're human: <input name="bot-field" />
        </label>
      </p>

      <!-- Community Title -->
      <div>
        <label for="title" class="block text-xs font-black uppercase tracking-wider text-black mb-1.5">
          Group / Channel Name <span class="text-rose-500">*</span>
        </label>
        <input
          type="text"
          name="title"
          id="title"
          required
          maxlength="100"
          placeholder="e.g., London Tech Jobs & Hiring"
          class="w-full rounded-xl border-2 border-black px-4 py-2.5 text-sm font-medium text-black placeholder:text-slate-500 shadow-[2px_2px_0px_0px_#000] focus:outline-none focus:shadow-[4px_4px_0px_0px_#000]"
        />
      </div>

      <!-- Country & Platform Row -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <!-- Target Country -->
        <div>
          <label for="countryCode" class="block text-xs font-black uppercase tracking-wider text-black mb-1.5">
            Target Country <span class="text-rose-500">*</span>
          </label>
          <select
            name="countryCode"
            id="countryCode"
            required
            class="w-full rounded-xl border-2 border-black bg-[#FAF8F5] px-4 py-2.5 text-sm font-bold text-black shadow-[2px_2px_0px_0px_#000] focus:bg-white focus:outline-none"
          >
            <option value="">Select Country...</option>
            {ENABLED_COUNTRIES.map((c) => (
              <option value={c.code}>{c.flag} {c.name}</option>
            ))}
            <option value="GLOBAL">?? Global Remote</option>
          </select>
        </div>

        <!-- Platform -->
        <div>
          <label for="platform" class="block text-xs font-black uppercase tracking-wider text-black mb-1.5">
            Platform <span class="text-rose-500">*</span>
          </label>
          <select
            name="platform"
            id="platform"
            required
            class="w-full rounded-xl border-2 border-black bg-[#FAF8F5] px-4 py-2.5 text-sm font-bold text-black shadow-[2px_2px_0px_0px_#000] focus:bg-white focus:outline-none"
          >
            <option value="">Select Platform...</option>
            {platforms.filter((p) => p.isConfigured).map((p) => (
              <option value={p.id}>{p.name}</option>
            ))}
          </select>
        </div>
      </div>

      <!-- Category & Work Arrangement Row -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <!-- Category -->
        <div>
          <label for="category" class="block text-xs font-black uppercase tracking-wider text-black mb-1.5">
            Job Category <span class="text-rose-500">*</span>
          </label>
          <select
            name="category"
            id="category"
            required
            class="w-full rounded-xl border-2 border-black bg-[#FAF8F5] px-4 py-2.5 text-sm font-bold text-black shadow-[2px_2px_0px_0px_#000] focus:bg-white focus:outline-none"
          >
            <option value="">Select Category...</option>
            {categories.map((c) => (
              <option value={c.slug}>{c.name}</option>
            ))}
          </select>
        </div>

        <!-- Work Arrangement -->
        <div>
          <label for="workArrangement" class="block text-xs font-black uppercase tracking-wider text-black mb-1.5">
            Work Arrangement
          </label>
          <select
            name="workArrangement"
            id="workArrangement"
            class="w-full rounded-xl border-2 border-black bg-[#FAF8F5] px-4 py-2.5 text-sm font-bold text-black shadow-[2px_2px_0px_0px_#000] focus:bg-white focus:outline-none"
          >
            <option value="unknown">Not Specified / Mixed</option>
            <option value="remote">Remote</option>
            <option value="hybrid">Hybrid</option>
            <option value="onsite">On-Site</option>
          </select>
        </div>
      </div>

      <!-- Invite URL -->
      <div>
        <label for="inviteUrl" class="block text-xs font-black uppercase tracking-wider text-black mb-1.5">
          Public Invite URL <span class="text-rose-500">*</span>
        </label>
        <input
          type="url"
          name="inviteUrl"
          id="inviteUrl"
          required
          placeholder="https://t.me/example, https://discord.gg/example, or https://chat.whatsapp.com/..."
          class="w-full rounded-xl border-2 border-black px-4 py-2.5 text-sm font-medium text-black placeholder:text-slate-500 shadow-[2px_2px_0px_0px_#000] focus:outline-none focus:shadow-[4px_4px_0px_0px_#000]"
        />
      </div>

      <!-- Description -->
      <div>
        <label for="description" class="block text-xs font-black uppercase tracking-wider text-black mb-1.5">
          Factual Description <span class="text-rose-500">*</span>
        </label>
        <textarea
          name="description"
          id="description"
          rows="3"
          required
          maxlength="500"
          placeholder="Briefly describe what types of jobs are posted (e.g., UK nursing vacancies, US remote frontend engineering roles). Avoid hype."
          class="w-full rounded-xl border-2 border-black px-4 py-2.5 text-sm font-medium text-black placeholder:text-slate-500 shadow-[2px_2px_0px_0px_#000] focus:outline-none focus:shadow-[4px_4px_0px_0px_#000]"
        ></textarea>
      </div>

      <!-- Admin Contact (Private) -->
      <div>
        <label for="adminContact" class="block text-xs font-black uppercase tracking-wider text-black mb-1.5">
          Admin Email or Contact (Private / Optional)
        </label>
        <input
          type="email"
          name="adminContact"
          id="adminContact"
          placeholder="admin@example.com"
          class="w-full rounded-xl border-2 border-black px-4 py-2.5 text-sm font-medium text-black placeholder:text-slate-500 shadow-[2px_2px_0px_0px_#000] focus:outline-none focus:shadow-[4px_4px_0px_0px_#000]"
        />
        <p class="mt-1.5 text-xs font-bold text-slate-600">
          Used solely for listing moderation. Never published.
        </p>
      </div>

      <!-- Consent Checkbox -->
      <div class="pt-2">
        <label class="flex items-start gap-3 cursor-pointer">
          <input
            type="checkbox"
            name="confirmedPublic"
            required
            class="mt-1 h-5 w-5 rounded border-2 border-black text-emerald-600 focus:ring-0"
          />
          <span class="text-xs font-bold text-black leading-relaxed">
            I confirm that this community is a legitimate job alert channel and does not require candidates to pay money, complete paid task schemes, or deposit crypto.
          </span>
        </label>
      </div>

      <!-- Submit Button -->
      <div>
        <button
          type="submit"
          class="neo-button w-full bg-[#A7F3D0] hover:bg-[#6EE7B7] py-3.5 text-sm font-black text-black shadow-[4px_4px_0px_0px_#000]"
        >
          Submit Job Community for Review ?
        </button>
      </div>
    </form>
  </div>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { categories } from "../config/categories";
import { platforms } from "../config/platforms";
import { generateBreadcrumbSchema } from "../lib/schema";

const breadcrumbs = [
  { name: "Home", item: "/" },
  { name: "Submit Community", item: "/submit" },
];

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs);
---

<BaseLayout
  title="Submit a Community"
  description="Submit a public Telegram channel, Discord server, or WhatsApp group to be catalogued in the directory."
  canonicalPath="/submit"
  jsonLd={breadcrumbSchema}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <Breadcrumbs items={breadcrumbs} />

    <div class="mb-8 p-6 sm:p-8 rounded-3xl border-[3px] border-black bg-[#FEF08A] shadow-[5px_5px_0px_0px_#000]">
      <div class="inline-block bg-white px-2 py-0.5 border-2 border-black text-[10px] font-black uppercase tracking-wider shadow-[1.5px_1.5px_0px_0px_#000] mb-2">
        COMMUNITY SUBMISSIONS
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-black tracking-tight">
        Submit a Community
      </h1>
      <p class="mt-2 text-sm font-bold text-black/80 leading-relaxed">
        Suggest a publicly discoverable online community. Every submission is reviewed to ensure link validity, correct categorization, and adherence to safety guidelines.
      </p>
    </div>

    <!-- Submission Guidelines Box -->
    <div class="mb-8 neo-card-mint p-6 text-xs text-black font-bold space-y-2">
      <strong class="font-black text-black block text-sm uppercase tracking-wide">📋 Submission Policy & Review Process</strong>
      <ul class="list-disc pl-4 space-y-1.5 text-black">
        <li><strong>Public Communities Only:</strong> Do not submit private groups or password-protected resources.</li>
        <li><strong>No Guaranteed Listing:</strong> Submission does not guarantee inclusion in the directory.</li>
        <li><strong>Zero Tolerance for Scams:</strong> Fraudulent schemes, malware, pirated accounts, or misleading claims will be permanently rejected.</li>
        <li><strong>Private Contact Information:</strong> Any admin email provided is kept strictly confidential and never displayed on public pages.</li>
      </ul>
    </div>

    <!-- Netlify Form -->
    <form
      name="community-submission"
      method="POST"
      action="/submit-success"
      data-netlify="true"
      netlify-honeypot="bot-field"
      class="rounded-3xl border-[3px] border-black bg-white p-6 sm:p-8 shadow-[6px_6px_0px_0px_#000] space-y-6"
    >
      <!-- Hidden Netlify Form identification -->
      <input type="hidden" name="form-name" value="community-submission" />

      <!-- Honeypot Field for anti-bot protection -->
      <p class="hidden">
        <label>
          Don’t fill this out if you're human: <input name="bot-field" />
        </label>
      </p>

      <!-- Community Title -->
      <div>
        <label for="title" class="block text-xs font-black uppercase tracking-wider text-black mb-1.5">
          Community Name <span class="text-rose-500">*</span>
        </label>
        <input
          type="text"
          name="title"
          id="title"
          required
          maxlength="100"
          placeholder="e.g., Python Developers Global"
          class="w-full rounded-xl border-2 border-black px-4 py-2.5 text-sm font-medium text-black placeholder:text-slate-500 shadow-[2px_2px_0px_0px_#000] focus:outline-none focus:shadow-[4px_4px_0px_0px_#000]"
        />
      </div>

      <!-- Platform & Category Row -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <!-- Platform -->
        <div>
          <label for="platform" class="block text-xs font-black uppercase tracking-wider text-black mb-1.5">
            Platform <span class="text-rose-500">*</span>
          </label>
          <select
            name="platform"
            id="platform"
            required
            class="w-full rounded-xl border-2 border-black bg-[#FAF8F5] px-4 py-2.5 text-sm font-bold text-black shadow-[2px_2px_0px_0px_#000] focus:bg-white focus:outline-none"
          >
            <option value="">Select Platform...</option>
            {platforms.filter((p) => p.isConfigured).map((p) => (
              <option value={p.id}>{p.name}</option>
            ))}
          </select>
        </div>

        <!-- Category -->
        <div>
          <label for="category" class="block text-xs font-black uppercase tracking-wider text-black mb-1.5">
            Category <span class="text-rose-500">*</span>
          </label>
          <select
            name="category"
            id="category"
            required
            class="w-full rounded-xl border-2 border-black bg-[#FAF8F5] px-4 py-2.5 text-sm font-bold text-black shadow-[2px_2px_0px_0px_#000] focus:bg-white focus:outline-none"
          >
            <option value="">Select Category...</option>
            {categories.map((c) => (
              <option value={c.slug}>{c.name}</option>
            ))}
          </select>
        </div>
      </div>

      <!-- Invite URL -->
      <div>
        <label for="inviteUrl" class="block text-xs font-black uppercase tracking-wider text-black mb-1.5">
          Public Invite URL <span class="text-rose-500">*</span>
        </label>
        <input
          type="url"
          name="inviteUrl"
          id="inviteUrl"
          required
          placeholder="https://t.me/example or https://discord.gg/example"
          class="w-full rounded-xl border-2 border-black px-4 py-2.5 text-sm font-medium text-black placeholder:text-slate-500 shadow-[2px_2px_0px_0px_#000] focus:outline-none focus:shadow-[4px_4px_0px_0px_#000]"
        />
        <p class="mt-1.5 text-xs font-bold text-slate-600">
          Must be a direct, publicly accessible invite link (e.g. t.me, discord.gg, chat.whatsapp.com).
        </p>
      </div>

      <!-- Description -->
      <div>
        <label for="description" class="block text-xs font-black uppercase tracking-wider text-black mb-1.5">
          Factual Description <span class="text-rose-500">*</span>
        </label>
        <textarea
          name="description"
          id="description"
          rows="3"
          required
          maxlength="500"
          placeholder="Briefly state what the community discusses or builds. Please avoid promotional hype, earnings claims, or spam."
          class="w-full rounded-xl border-2 border-black px-4 py-2.5 text-sm font-medium text-black placeholder:text-slate-500 shadow-[2px_2px_0px_0px_#000] focus:outline-none focus:shadow-[4px_4px_0px_0px_#000]"
        ></textarea>
      </div>

      <!-- Tags & Language Row -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label for="tags" class="block text-xs font-black uppercase tracking-wider text-black mb-1.5">
            Tags / Keywords (comma-separated)
          </label>
          <input
            type="text"
            name="tags"
            id="tags"
            placeholder="e.g. python, automation, machine-learning"
            class="w-full rounded-xl border-2 border-black px-4 py-2.5 text-sm font-medium text-black placeholder:text-slate-500 shadow-[2px_2px_0px_0px_#000] focus:outline-none focus:shadow-[4px_4px_0px_0px_#000]"
          />
        </div>

        <div>
          <label for="language" class="block text-xs font-black uppercase tracking-wider text-black mb-1.5">
            Primary Language
          </label>
          <input
            type="text"
            name="language"
            id="language"
            placeholder="e.g. English, Spanish, Global"
            class="w-full rounded-xl border-2 border-black px-4 py-2.5 text-sm font-medium text-black placeholder:text-slate-500 shadow-[2px_2px_0px_0px_#000] focus:outline-none focus:shadow-[4px_4px_0px_0px_#000]"
          />
        </div>
      </div>

      <!-- Admin Contact (Private) -->
      <div>
        <label for="adminContact" class="block text-xs font-black uppercase tracking-wider text-black mb-1.5">
          Admin Email or Contact (Private / Optional)
        </label>
        <input
          type="email"
          name="adminContact"
          id="adminContact"
          placeholder="admin@example.com"
          class="w-full rounded-xl border-2 border-black px-4 py-2.5 text-sm font-medium text-black placeholder:text-slate-500 shadow-[2px_2px_0px_0px_#000] focus:outline-none focus:shadow-[4px_4px_0px_0px_#000]"
        />
        <p class="mt-1.5 text-xs font-bold text-slate-600">
          Used solely for listing verification questions. Strictly confidential and never published.
        </p>
      </div>

      <!-- Consent Checkbox -->
      <div class="pt-2">
        <label class="flex items-start gap-3 cursor-pointer">
          <input
            type="checkbox"
            name="confirmedPublic"
            required
            class="mt-1 h-5 w-5 rounded border-2 border-black text-emerald-600 focus:ring-0"
          />
          <span class="text-xs font-bold text-black leading-relaxed">
            I confirm that this community is publicly discoverable and that I have the right to submit this information. I understand that fraudulent, abusive, or financial-scam listings will be discarded.
          </span>
        </label>
      </div>

      <!-- Submit Button -->
      <div>
        <button
          type="submit"
          class="neo-button w-full bg-[#A7F3D0] hover:bg-[#6EE7B7] py-3.5 text-sm font-black text-black shadow-[4px_4px_0px_0px_#000]"
        >
          Submit Community for Review →
        </button>
      </div>
    </form>
  </div>
</BaseLayout>

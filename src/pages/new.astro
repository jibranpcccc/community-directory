---
import DirectoryLayout from "../layouts/DirectoryLayout.astro";
import CommunityGrid from "../components/CommunityGrid.astro";
import { getRecentlyAdded } from "../lib/communities";
import { generateCollectionPageSchema } from "../lib/schema";

const recentCommunities = getRecentlyAdded(24);
const schema = generateCollectionPageSchema(
  "Recently Added Job Groups",
  "The latest publicly discovered job alert communities catalogued in the directory.",
  "/new",
  recentCommunities
);
---

<DirectoryLayout
  heading="Recently Added Job Groups"
  subheading="Discover the latest job alert communities recently added to our public directory."
  breadcrumbs={[
    { name: "All Jobs", item: "/jobs" },
    { name: "Recently Added", item: "/new" },
  ]}
  canonicalPath="/new"
  pageType="utility"
  jsonLd={schema}
  noindex={true}
>
  <div class="mb-6 flex items-center justify-between">
    <span class="text-xs font-bold text-black">
      Showing <strong class="underline font-black">{recentCommunities.length}</strong> latest additions
    </span>
  </div>

  <CommunityGrid
    communities={recentCommunities}
    emptyTitle="No recent communities"
    emptyMessage="No new communities have been added recently."
  />
</DirectoryLayout>

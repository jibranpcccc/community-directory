---
import DirectoryLayout from "../layouts/DirectoryLayout.astro";
import { siteConfig } from "../config/site";

const pageTitle = `Privacy Policy | ${siteConfig.name}`;
const pageDescription = "Our privacy practices regarding user data, submissions, and directory analytics.";
---

<DirectoryLayout
  heading="Privacy Policy"
  subheading="How JobAlertHub handles user privacy, submission emails, and analytics."
  breadcrumbs={[{ name: "Privacy Policy", item: "/privacy/" }]}
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/privacy/"
  pageType="legal"
  noindex={true}
>
  <div class="max-w-4xl mx-auto space-y-6 text-sm font-medium text-slate-800 leading-relaxed">
    <div class="neo-card p-6 sm:p-8 bg-white space-y-4">
      <h2 class="text-xl font-black text-black">Information We Collect</h2>
      <p class="text-slate-700">
        JobAlertHub is a static directory. We do not use user tracking cookies, tracking pixels, or invasive third-party analytics.
      </p>
      <h2 class="text-xl font-black text-black">Form Submissions & Contact Data</h2>
      <p class="text-slate-700">
        When you submit a community or file a report, any email address provided is transmitted securely via Netlify Forms and used solely by maintainers for review correspondence. We never sell, rent, or publicly publish submitter contact information.
      </p>
    </div>
  </div>
</DirectoryLayout>

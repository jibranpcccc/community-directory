---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchBox from "../components/SearchBox.astro";
import { categories } from "../config/categories";
---

<BaseLayout
  title="Page Not Found (404)"
  description="The requested community listing or page could not be found."
  canonicalPath="/404"
  noindex={true}
>
  <div class="max-w-3xl mx-auto px-4 py-16 sm:py-24 text-center">
    <div class="inline-flex items-center justify-center h-20 w-20 rounded-2xl border-[3px] border-black bg-[#FEF08A] text-black font-black text-3xl shadow-[4px_4px_0px_0px_#000] mb-6">
      404
    </div>

    <h1 class="text-3xl sm:text-5xl font-black text-black tracking-tight mb-4">
      Page or Listing Not Found
    </h1>

    <p class="text-sm sm:text-base font-bold text-slate-700 max-w-lg mx-auto leading-relaxed mb-8">
      The community listing or page you are looking for may have been moved, removed, or never existed. Try searching the directory below.
    </p>

    <!-- Search Box -->
    <div class="mb-10">
      <SearchBox size="md" />
    </div>

    <!-- Quick Navigation -->
    <div class="space-y-4">
      <div class="text-xs font-black uppercase tracking-wider text-black">
        Or browse by popular category:
      </div>
      <div class="flex flex-wrap justify-center gap-2">
        {
          categories.map((cat) => (
            <a
              href={`/category/${cat.slug}`}
              class="neo-button bg-white hover:bg-[#FEF9C3] px-3.5 py-2 text-xs font-black text-black"
            >
              {cat.name}
            </a>
          ))
        }
      </div>
    </div>

    <div class="mt-10 pt-8 border-t-2 border-black/10 flex justify-center gap-4">
      <a
        href="/"
        class="neo-button bg-[#A7F3D0] hover:bg-[#6EE7B7] px-5 py-2.5 text-xs font-black text-black"
      >
        Back to Home
      </a>
      <a
        href="/communities"
        class="neo-button bg-white hover:bg-slate-100 px-5 py-2.5 text-xs font-black text-black"
      >
        Browse All Communities
      </a>
    </div>
  </div>
</BaseLayout>

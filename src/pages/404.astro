---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config/site";
---

<BaseLayout
  title={`Page Not Found (404) | ${siteConfig.name}`}
  description="The requested page could not be found."
  canonicalPath="/404/"
  noindex={true}
  pageType="404"
>
  <div class="max-w-xl mx-auto px-4 py-16 text-center space-y-6">
    <div class="inline-block bg-[#FEF08A] px-4 py-1.5 border-2 border-black rounded-xl text-3xl font-black shadow-[3px_3px_0px_0px_#000]">
      404
    </div>
    <h1 class="text-3xl font-black text-black">Page Not Found</h1>
    <p class="text-sm font-medium text-slate-700 leading-relaxed">
      The directory page or group listing you were looking for doesn't exist or has been relocated.
    </p>
    <div class="pt-2">
      <a href="/jobs/" class="neo-button bg-[#A7F3D0] hover:bg-[#6EE7B7] text-black px-6 py-3 text-sm font-black">
        Explore All Job Groups &rarr;
      </a>
    </div>
  </div>
</BaseLayout>

---
import DirectoryLayout from "../../layouts/DirectoryLayout.astro";
import CommunityCard from "../../components/CommunityCard.astro";
import SafetyNotice from "../../components/SafetyNotice.astro";
import EmptyState from "../../components/EmptyState.astro";
import { TARGET_COUNTRIES, getCountryBySlug } from "../../config/countries";
import { getCommunitiesByCountry } from "../../lib/communities";
import { siteConfig } from "../../config/site";
import { generateCollectionPageSchema } from "../../lib/schema";
import { getIndexability } from "../../lib/seo";

export async function getStaticPaths() {
  return Object.values(TARGET_COUNTRIES).map((country) => ({
    params: { country: country.slug },
  }));
}

const { country } = Astro.params;
const countryConfig = getCountryBySlug(country);

if (!countryConfig) {
  return Astro.redirect("/404/");
}

const communities = getCommunitiesByCountry(countryConfig.code);
const isIndexable = getIndexability("country", communities.length);

const pageTitle = `Job Alert Groups in ${countryConfig.name} | ${siteConfig.name}`;
const pageDescription = `Discover active public Telegram channels, Discord servers, and WhatsApp groups for jobs and hiring in ${countryConfig.name}.`;

const collectionSchema = generateCollectionPageSchema(
  `Job Alert Groups in ${countryConfig.name}`,
  pageDescription,
  `/country/${countryConfig.slug}/`,
  communities
);
---

<DirectoryLayout
  heading={`Job Alert Groups in ${countryConfig.name}`}
  subheading={`Discover verified public career communities, Discord servers, and Telegram channels targeting ${countryConfig.name}.`}
  breadcrumbs={[{ name: countryConfig.name, item: `/country/${countryConfig.slug}/` }]}
  title={pageTitle}
  description={pageDescription}
  canonicalPath={`/country/${countryConfig.slug}/`}
  jsonLd={collectionSchema}
  noindex={!isIndexable}
  pageType="country"
>
  {
    communities.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mb-10">
        {communities.map((comm) => (
          <CommunityCard community={comm} />
        ))}
      </div>
    ) : (
      <div class="mb-10">
        <EmptyState
          title={`No ${countryConfig.name} Job Groups Listed Yet`}
          message={`We haven't indexed any active job alert communities for ${countryConfig.name} yet. Check back soon as our discovery engine runs daily.`}
          resetUrl="/jobs/"
        />
      </div>
    )
  }

  <SafetyNotice type="job-warning" />
</DirectoryLayout>

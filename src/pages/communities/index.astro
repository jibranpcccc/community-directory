---
import DirectoryLayout from "../../layouts/DirectoryLayout.astro";
import FilterBar from "../../components/FilterBar.astro";
import CommunityGrid from "../../components/CommunityGrid.astro";
import { getPublishedCommunities } from "../../lib/communities";
import { filterAndSortCommunities } from "../../lib/filters";
import { generateCollectionPageSchema } from "../../lib/schema";
import type { PlatformId, VerificationStatus, SortOption } from "../../types/community";

// Server-side parsing of URL query params for initial static/prerendered state
const search = Astro.url.searchParams.get("search") || undefined;
const category = Astro.url.searchParams.get("category") || undefined;
const platform = (Astro.url.searchParams.get("platform") as PlatformId) || undefined;
const verificationStatus = (Astro.url.searchParams.get("verificationStatus") as VerificationStatus) || undefined;
const sort = (Astro.url.searchParams.get("sort") as SortOption) || "newest";

const allPublished = getPublishedCommunities();
const filtered = filterAndSortCommunities(
  allPublished,
  { search, category, platform, verificationStatus },
  sort
);

const schema = generateCollectionPageSchema(
  "All Public Online Communities",
  "Search and browse public Telegram channels, Discord servers, and WhatsApp groups.",
  "/communities",
  filtered
);
---

<DirectoryLayout
  heading="Browse Communities"
  subheading="Explore verified and publicly discoverable online communities. Filter by category, chat platform, verification tier, and more."
  breadcrumbs={[{ name: "Communities", item: "/communities" }]}
  canonicalPath="/communities"
  jsonLd={schema}
>
  <!-- Filter & Search Controls -->
  <FilterBar
    currentFilters={{ search, category, platform, verificationStatus }}
    currentSort={sort}
    totalCount={filtered.length}
  />

  <!-- Interactive Grid Container -->
  <div id="communities-results-container">
    <CommunityGrid
      communities={filtered}
      emptyTitle="No matching communities"
      emptyMessage="We couldn't find any communities matching your current filters. Try changing your search keywords or resetting filters."
    />
  </div>
</DirectoryLayout>

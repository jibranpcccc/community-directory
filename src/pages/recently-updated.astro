---
import DirectoryLayout from "../layouts/DirectoryLayout.astro";
import CommunityCard from "../components/CommunityCard.astro";
import SafetyNotice from "../components/SafetyNotice.astro";
import { getAllPublishedCommunities } from "../lib/communities";
import { siteConfig } from "../config/site";

const allCommunities = getAllPublishedCommunities();
const recentCommunities = allCommunities.slice(0, 12);
---

<DirectoryLayout
  heading="Recently Checked Job Communities"
  subheading="Public job communities with recently revalidated invite health."
  breadcrumbs={[{ name: "Recently Checked", item: "/recently-updated/" }]}
  canonicalPath="/recently-updated/"
  noindex={true}
  pageType="utility"
>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mb-10">
    {recentCommunities.map((comm) => (
      <CommunityCard community={comm} />
    ))}
  </div>
  <SafetyNotice type="job-warning" />
</DirectoryLayout>

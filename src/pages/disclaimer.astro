---
import DirectoryLayout from "../layouts/DirectoryLayout.astro";
import { siteConfig } from "../config/site";

const pageTitle = `Disclaimer | ${siteConfig.name}`;
const pageDescription = "Legal and informational disclaimer regarding community listings and employment offers on JobAlertHub.";
---

<DirectoryLayout
  heading="Directory Disclaimer"
  subheading="Important information regarding listings, external links, and third-party employment opportunities."
  breadcrumbs={[{ name: "Disclaimer", item: "/disclaimer/" }]}
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/disclaimer/"
  pageType="trust"
>
  <div class="max-w-4xl mx-auto space-y-6 text-sm font-medium text-slate-800 leading-relaxed">
    <div class="neo-card p-6 sm:p-8 bg-white space-y-4">
      <h2 class="text-xl font-black text-black">No Guarantee of Employment</h2>
      <p class="text-slate-700">
        JobAlertHub is a searchable public directory of third-party communities. Inclusion of any Telegram channel, Discord server, or WhatsApp group does NOT constitute an endorsement, recommendation, or guarantee of employment.
      </p>
      <h2 class="text-xl font-black text-black">External Third-Party Content</h2>
      <p class="text-slate-700">
        We do not control and are not responsible for messages, job postings, recruiter communications, or files shared within third-party communities. Job seekers must perform independent due diligence before sharing sensitive personal or financial information.
      </p>
      <h2 class="text-xl font-black text-black">Financial Risk Warning</h2>
      <p class="text-slate-700">
        Legitimate employers will never ask for payment, training fees, or cryptocurrency deposits. If any community demands money for employment, exit immediately and report the listing.
      </p>
    </div>
  </div>
</DirectoryLayout>

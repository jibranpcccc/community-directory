---
import DirectoryLayout from "../layouts/DirectoryLayout.astro";
import VerificationBadge from "../components/VerificationBadge.astro";
import { generateFAQSchema } from "../lib/schema";

const faqSchema = generateFAQSchema([
  {
    question: "What does the Active Link status mean?",
    answer: "The public invite link was tested and verified as reachable during our latest automated check. It confirms the link is active and valid, but does not constitute an endorsement of job offers posted inside.",
  },
  {
    question: "What does the Source Confirmed status mean?",
    answer: "The invite link or server identifier was independently corroborated by an outbound reference on an authoritative public website or official organization page.",
  },
  {
    question: "How often are published communities rechecked?",
    answer: "Every published community is rechecked automatically on a daily schedule. If a link expires or returns an error across multiple consecutive checks, it is automatically unpublished.",
  },
  {
    question: "Does listing inclusion mean employers are verified?",
    answer: "No. Directory inclusion confirms only that the community exists and meets public link health standards. Job seekers must always verify employers and job postings independently.",
  },
]);
---

<DirectoryLayout
  heading="How We Verify Job Communities"
  subheading="A transparent breakdown of our data standards, automated validation pipeline, and trust tiers."
  breadcrumbs={[
    { name: "All Jobs", item: "/jobs" },
    { name: "How We Verify", item: "/how-we-verify" },
  ]}
  canonicalPath="/how-we-verify"
  pageType="trust"
  jsonLd={faqSchema}
>
  <div class="max-w-4xl mx-auto space-y-8 text-sm sm:text-base font-medium text-slate-800 leading-relaxed">
    <!-- Core Standard Card -->
    <div class="neo-card p-6 sm:p-8 bg-white">
      <div class="inline-block bg-[#FEF08A] px-2 py-0.5 border-2 border-black text-[10px] font-black uppercase tracking-wider shadow-[1.5px_1.5px_0px_0px_#000] mb-2">
        TRANSPARENT METHODOLOGY
      </div>
      <h2 class="text-2xl font-black text-black tracking-tight mb-3">Our Core Verification Standard</h2>
      <p class="font-bold text-slate-700">
        Unlike directories that invent fake "Verified" badges to create a false impression of security, JobAlertHub strictly separates link reachability from independent source corroboration.
      </p>
    </div>

    <!-- Mandatory Verification Disclaimer -->
    <div class="rounded-2xl border-[3px] border-black bg-[#FEF08A] p-6 shadow-[4px_4px_0px_0px_#000] text-black font-bold space-y-2">
      <strong class="font-black text-black block text-base uppercase tracking-wide">
        ?? Mandatory Job Verification Notice
      </strong>
      <p class="text-sm leading-relaxed">
        A working community link does NOT mean every job posting inside that community has been independently verified.
      </p>
      <p class="text-xs text-slate-800 font-medium">
        Public groups may contain third-party user messages or recruiters that have not been vetted by our directory. Always verify employers directly on their official company domain before applying or sharing personal information.
      </p>
    </div>

    <!-- Status Definitions Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Active Link / Unverified Source -->
      <div class="neo-card p-6 space-y-3 bg-white">
        <div class="flex items-center justify-between">
          <h3 class="text-base font-black text-black">Active Link</h3>
          <span class="rounded-lg border-2 border-black bg-[#A7F3D0] px-2.5 py-0.5 text-xs font-black text-black shadow-[1.5px_1.5px_0px_0px_#000]">Active</span>
        </div>
        <p class="text-xs font-bold text-slate-600">
          The public invite link was confirmed active and reachable within the last 24 hours. The community passed all geographic and safety checks.
        </p>
      </div>

      <!-- Source Confirmed -->
      <div class="neo-card p-6 space-y-3 bg-white">
        <div class="flex items-center justify-between">
          <h3 class="text-base font-black text-black">Source Confirmed</h3>
          <span class="rounded-lg border-2 border-black bg-[#BAE6FD] px-2.5 py-0.5 text-xs font-black text-black shadow-[1.5px_1.5px_0px_0px_#000]">Source Confirmed</span>
        </div>
        <p class="text-xs font-bold text-slate-600">
          The invite link or server ID was verified through an exact outbound link on an authoritative primary website or official organization page.
        </p>
      </div>
    </div>

    <!-- 4-Stage Lifecycle Explanation -->
    <div class="neo-card p-6 sm:p-8 bg-white space-y-6">
      <div class="inline-block bg-[#DDD6FE] px-2 py-0.5 border-2 border-black text-[10px] font-black uppercase tracking-wider shadow-[1.5px_1.5px_0px_0px_#000]">
        PIPELINE
      </div>
      <h2 class="text-2xl font-black text-black tracking-tight">The 4-Stage Automated Lifecycle</h2>

      <div class="space-y-4">
        <div class="p-4 border-2 border-black rounded-xl bg-[#FEF9C3] shadow-[2px_2px_0px_0px_#000]">
          <h3 class="font-black text-black text-sm mb-1">1. Discovery & Intent Screening</h3>
          <p class="text-xs text-slate-700">
            Public queries discover candidates across Discord, Telegram, and WhatsApp. Candidates must demonstrate explicit employment and hiring intent for US, UK, Canada, or Australia.
          </p>
        </div>

        <div class="p-4 border-2 border-black rounded-xl bg-[#BAE6FD] shadow-[2px_2px_0px_0px_#000]">
          <h3 class="font-black text-black text-sm mb-1">2. Platform Health & Independent Verification</h3>
          <p class="text-xs text-slate-700">
            Invite endpoints are tested against official platform APIs or web endpoints. Independent source pages are fetched to confirm outbound invite links.
          </p>
        </div>

        <div class="p-4 border-2 border-black rounded-xl bg-[#DDD6FE] shadow-[2px_2px_0px_0px_#000]">
          <h3 class="font-black text-black text-sm mb-1">3. Safety & Fraud Filters</h3>
          <p class="text-xs text-slate-700">
            Automated filters inspect community titles and descriptions against known employment fraud patterns, task scams, and upfront fee schemes.
          </p>
        </div>

        <div class="p-4 border-2 border-black rounded-xl bg-[#A7F3D0] shadow-[2px_2px_0px_0px_#000]">
          <h3 class="font-black text-black text-sm mb-1">4. Daily Revalidation & Auto-Unpublish</h3>
          <p class="text-xs text-slate-700">
            Every published community is rechecked daily. Dead links, renamed non-job channels, or compromised groups are automatically unpublished.
          </p>
        </div>
      </div>
    </div>
  </div>
</DirectoryLayout>

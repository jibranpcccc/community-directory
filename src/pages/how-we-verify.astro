---
import DirectoryLayout from "../layouts/DirectoryLayout.astro";
import VerificationBadge from "../components/VerificationBadge.astro";

const pageTitle = "How We Verify Job Communities | JobAlertHub";
const pageDescription = "A transparent breakdown of our data standards, automated validation pipeline, and trust tiers.";
---

<DirectoryLayout
  heading="How We Verify Job Communities"
  subheading="A transparent breakdown of our data standards, automated validation pipeline, and trust tiers."
  breadcrumbs={[
    { name: "All Jobs", item: "/jobs/" },
    { name: "How We Verify", item: "/how-we-verify/" },
  ]}
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/how-we-verify/"
  pageType="trust"
>
  <div class="max-w-4xl mx-auto space-y-8 text-sm sm:text-base font-medium text-slate-800 leading-relaxed">
    <!-- Core Standard Card -->
    <div class="neo-card p-6 sm:p-8 bg-white">
      <div class="inline-block bg-[#FEF08A] px-2 py-0.5 border-2 border-black text-[10px] font-black uppercase tracking-wider shadow-[1.5px_1.5px_0px_0px_#000] mb-2">
        ZERO TOLERANCE
      </div>
      <h2 class="text-xl sm:text-2xl font-black text-black tracking-tight">
        Zero Hallucination & Evidence-First Standard
      </h2>
      <p class="mt-3 text-slate-700 leading-relaxed">
        Our directory operates under strict engineering principles: <strong>we never invent community names, invite links, member counts, ratings, or founder identities.</strong> If a data point cannot be independently corroborated through public domain records or platform metadata, it remains unlisted.
      </p>
    </div>

    <!-- Verification Badges Explained -->
    <section class="space-y-4">
      <h2 class="text-xl sm:text-2xl font-black text-black">
        Directory Status Badges Explained
      </h2>
      <p class="text-xs sm:text-sm font-bold text-slate-600">
        Every listing in our directory displays one of these factual verification badges:
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Active Link Badge -->
        <div class="neo-card p-5 bg-white space-y-2">
          <div class="flex items-center justify-between">
            <span class="inline-flex items-center gap-1.5 rounded-lg border-2 border-black bg-[#A7F3D0] px-2.5 py-1 text-xs font-black text-black shadow-[1.5px_1.5px_0px_0px_#000]">
              <span class="h-2 w-2 rounded-full bg-emerald-600"></span>
              Active Link
            </span>
            <span class="text-[11px] font-black text-slate-500 uppercase">Tier 1 Gated</span>
          </div>
          <h3 class="text-sm font-black text-black">Tested Reachable Link</h3>
          <p class="text-xs font-medium text-slate-700 leading-relaxed">
            The community invite was tested and confirmed reachable during our latest automated validation cycle. Indicates the group exists and the link is active.
          </p>
        </div>

        <!-- Source Confirmed Badge -->
        <div class="neo-card p-5 bg-white space-y-2">
          <div class="flex items-center justify-between">
            <span class="inline-flex items-center gap-1.5 rounded-lg border-2 border-black bg-[#BAE6FD] px-2.5 py-1 text-xs font-black text-black shadow-[1.5px_1.5px_0px_0px_#000]">
              <span class="h-2 w-2 rounded-full bg-sky-600"></span>
              Source Confirmed
            </span>
            <span class="text-[11px] font-black text-slate-500 uppercase">Tier A Verified</span>
          </div>
          <h3 class="text-sm font-black text-black">Authoritative Web Backing</h3>
          <p class="text-xs font-medium text-slate-700 leading-relaxed">
            The community invite link was discovered or corroborated by an independent authoritative domain (e.g. an official company blog, university website, or open-source foundation).
          </p>
        </div>

        <!-- Owner Confirmed Badge -->
        <div class="neo-card p-5 bg-white space-y-2">
          <div class="flex items-center justify-between">
            <span class="inline-flex items-center gap-1.5 rounded-lg border-2 border-black bg-[#DDD6FE] px-2.5 py-1 text-xs font-black text-black shadow-[1.5px_1.5px_0px_0px_#000]">
              <span class="h-2 w-2 rounded-full bg-purple-600"></span>
              Owner Confirmed
            </span>
            <span class="text-[11px] font-black text-slate-500 uppercase">Admin Verified</span>
          </div>
          <h3 class="text-sm font-black text-black">Administrator Attestation</h3>
          <p class="text-xs font-medium text-slate-700 leading-relaxed">
            The listing administrator has confirmed ownership and provided active contact credentials to maintain listing accuracy.
          </p>
        </div>

        <!-- Manually Reviewed Badge -->
        <div class="neo-card p-5 bg-white space-y-2">
          <div class="flex items-center justify-between">
            <span class="inline-flex items-center gap-1.5 rounded-lg border-2 border-black bg-[#FEF08A] px-2.5 py-1 text-xs font-black text-black shadow-[1.5px_1.5px_0px_0px_#000]">
              <span class="h-2 w-2 rounded-full bg-amber-600"></span>
              Manually Reviewed
            </span>
            <span class="text-[11px] font-black text-slate-500 uppercase">Curated</span>
          </div>
          <h3 class="text-sm font-black text-black">Editorial Review</h3>
          <p class="text-xs font-medium text-slate-700 leading-relaxed">
            A human directory maintainer has manually audited the community topic, membership rules, and focus areas.
          </p>
        </div>
      </div>
    </section>

    <!-- The 4-Stage Automated Lifecycle -->
    <section class="neo-card p-6 sm:p-8 space-y-4 bg-white">
      <div class="inline-block bg-[#BAE6FD] px-2 py-0.5 border-2 border-black text-[10px] font-black uppercase tracking-wider shadow-[1.5px_1.5px_0px_0px_#000]">
        SYSTEM LIFECYCLE
      </div>
      <h2 class="text-xl sm:text-2xl font-black text-black">
        The 4-Stage Listing Lifecycle
      </h2>
      <div class="space-y-4 text-xs sm:text-sm font-medium text-slate-700">
        <div class="border-l-4 border-black pl-4 py-1">
          <strong class="text-black font-black block text-sm">1. Public Discovery</strong>
          Candidate communities are discovered from public web references, indexing portals, or user submissions.
        </div>
        <div class="border-l-4 border-black pl-4 py-1">
          <strong class="text-black font-black block text-sm">2. 12-Gate Safety & Quality Audit</strong>
          Every candidate must pass 12 programmatic checks: URL format normalization, anti-scam heuristics, geographic target evidence, link accessibility, and duplication detection.
        </div>
        <div class="border-l-4 border-black pl-4 py-1">
          <strong class="text-black font-black block text-sm">3. Probation & Multi-Observation Validation</strong>
          Unverified listings undergo probation observation across multiple discovery cycles before public publishing.
        </div>
        <div class="border-l-4 border-black pl-4 py-1">
          <strong class="text-black font-black block text-sm">4. Continuous Daily Revalidation</strong>
          All published listings are re-tested daily. Listings with broken or expired invites are automatically unpublished to preserve directory quality.
        </div>
      </div>
    </section>

    <!-- Report & Takedown Callout -->
    <div class="rounded-3xl border-[3px] border-black bg-[#FECDD3] p-6 sm:p-8 shadow-[6px_6px_0px_0px_#000] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div>
        <h3 class="text-lg font-black text-black">Notice a Broken Link or Misleading Info?</h3>
        <p class="mt-1 text-xs sm:text-sm font-bold text-black/80">
          Our moderation desk immediately reviews user reports and community owner update requests.
        </p>
      </div>
      <a
        href="/report/"
        class="neo-btn bg-white hover:bg-slate-100 text-black px-4 py-2.5 text-xs font-black shrink-0 border-2 border-black shadow-[2px_2px_0px_0px_#000]"
      >
        Submit a Report &rarr;
      </a>
    </div>
  </div>
</DirectoryLayout>

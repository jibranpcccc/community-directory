---
import DirectoryLayout from "../layouts/DirectoryLayout.astro";
import VerificationBadge from "../components/VerificationBadge.astro";
import { generateFAQSchema } from "../lib/schema";

const faqSchema = generateFAQSchema([
  {
    question: "What does the Unverified badge mean?",
    answer: "The public invite link was discovered through automated search or indexing, but no direct confirmation has been performed with an official primary domain or community owner.",
  },
  {
    question: "What does the Source Confirmed badge mean?",
    answer: "The invite link was linked directly from an official, authoritative website (e.g. project homepage, GitHub repository, official docs) confirming genuine community association.",
  },
  {
    question: "What does the Owner Confirmed badge mean?",
    answer: "The community founder or recognized administrator submitted verifiable proof of ownership and controls the listing details.",
  },
  {
    question: "What does the Manually Reviewed badge mean?",
    answer: "A human moderator independently inspected the link, title, categorization, and public activity to confirm basic legitimacy and absence of obvious spam.",
  },
]);
---

<DirectoryLayout
  heading="How We Verify Listings"
  subheading="A transparent breakdown of our verification tiers and what each badge means."
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "How We Verify", item: "/how-we-verify" },
  ]}
  canonicalPath="/how-we-verify"
  jsonLd={faqSchema}
>
  <div class="max-w-4xl mx-auto space-y-8 text-sm sm:text-base font-medium text-slate-800 leading-relaxed">
    <div class="neo-card p-6 sm:p-8 bg-white">
      <div class="inline-block bg-[#FEF08A] px-2 py-0.5 border-2 border-black text-[10px] font-black uppercase tracking-wider shadow-[1.5px_1.5px_0px_0px_#000] mb-2">
        ZERO HALLUCINATION
      </div>
      <h2 class="text-2xl font-black text-black tracking-tight mb-3">Our Core Verification Principle</h2>
      <p class="font-bold text-slate-700">
        Unlike many directories that generate fake "Verified" checkmarks to create an illusion of trust, our directory utilizes strictly defined verification states. We never use the word "Verified" without concrete evidence.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Unverified -->
      <div class="neo-card p-6 space-y-3 bg-white">
        <div class="flex items-center justify-between">
          <h3 class="text-base font-black text-black">1. Unverified</h3>
          <VerificationBadge status="unverified" />
        </div>
        <p class="text-xs font-bold text-slate-600">
          The public invite link was discovered through automated search or indexing, but no direct confirmation has been performed with an official primary domain or community owner.
        </p>
      </div>

      <!-- Source Confirmed -->
      <div class="neo-card bg-[#BAE6FD] p-6 space-y-3">
        <div class="flex items-center justify-between">
          <h3 class="text-base font-black text-black">2. Source Confirmed</h3>
          <VerificationBadge status="source-confirmed" />
        </div>
        <p class="text-xs font-bold text-slate-800">
          The invite link was linked directly from an official, authoritative website (e.g. project homepage, GitHub repository, official docs) confirming genuine community association.
        </p>
      </div>

      <!-- Owner Confirmed -->
      <div class="neo-card-mint p-6 space-y-3">
        <div class="flex items-center justify-between">
          <h3 class="text-base font-black text-black">3. Owner Confirmed</h3>
          <VerificationBadge status="owner-confirmed" />
        </div>
        <p class="text-xs font-bold text-slate-800">
          The community founder or recognized administrator submitted verifiable proof of ownership and controls the listing details.
        </p>
      </div>

      <!-- Manually Reviewed -->
      <div class="neo-card-purple p-6 space-y-3">
        <div class="flex items-center justify-between">
          <h3 class="text-base font-black text-black">4. Manually Reviewed</h3>
          <VerificationBadge status="manually-reviewed" />
        </div>
        <p class="text-xs font-bold text-slate-800">
          A human moderator independently inspected the link, title, categorization, and public activity to confirm basic legitimacy and absence of obvious spam.
        </p>
      </div>
    </div>

    <!-- Clear Scope Limitation -->
    <div class="neo-card-yellow p-6 text-xs sm:text-sm text-black font-bold space-y-2">
      <strong class="font-black text-black block text-sm uppercase tracking-wide">⚠️ Important Safety Limitation</strong>
      <p>
        Verification of identity or source is NOT a guarantee of ongoing security, safety, or financial returns. Group ownership can change, and malicious actors can compromise accounts. Users must always maintain personal vigilance.
      </p>
    </div>
  </div>
</DirectoryLayout>

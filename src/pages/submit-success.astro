---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Submission Received"
  description="Thank you for submitting a community to our directory."
  noindex={true}
>
  <div class="max-w-xl mx-auto px-4 py-16 sm:py-24 text-center">
    <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-emerald-100 text-emerald-600 mb-6">
      <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
    </div>

    <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mb-3">
      Submission Received
    </h1>

    <p class="text-sm text-slate-600 leading-relaxed mb-8">
      Thank you for submitting a community! Our moderation team will review the link validity, categorization, and safety criteria. Approved listings will be included in the next directory build.
    </p>

    <div class="flex justify-center gap-4">
      <a
        href="/"
        class="rounded-xl bg-slate-900 px-5 py-2.5 text-xs font-semibold text-white hover:bg-slate-800 transition-colors"
      >
        Back to Home
      </a>
      <a
        href="/communities"
        class="rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-colors"
      >
        Browse Directory
      </a>
    </div>
  </div>
</BaseLayout>

---
import DirectoryLayout from "../layouts/DirectoryLayout.astro";
---

<DirectoryLayout
  heading="Community Submission Received"
  subheading="Thank you for submitting a public job community for review."
  canonicalPath="/submit-success/"
  noindex={true}
  pageType="utility"
>
  <div class="max-w-xl mx-auto neo-card-mint p-8 text-center space-y-4">
    <h2 class="text-2xl font-black text-black">Submission Successful!</h2>
    <p class="text-xs sm:text-sm font-bold text-black/80 leading-relaxed">
      Our automated verification pipeline will test the invite link within 24 hours. Valid communities will be indexed.
    </p>
    <div class="pt-4">
      <a href="/jobs/" class="neo-button bg-white hover:bg-slate-100 text-black px-6 py-2.5 text-xs font-black">
        Return to Directory &rarr;
      </a>
    </div>
  </div>
</DirectoryLayout>

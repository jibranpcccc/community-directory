---
import DirectoryLayout from "../layouts/DirectoryLayout.astro";
import { siteConfig } from "../config/site";

const pageTitle = `Terms of Service | ${siteConfig.name}`;
const pageDescription = "Terms and conditions for browsing and submitting communities to JobAlertHub.";
---

<DirectoryLayout
  heading="Terms of Service"
  subheading="Terms and conditions governing use of the JobAlertHub directory."
  breadcrumbs={[{ name: "Terms of Service", item: "/terms/" }]}
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/terms/"
  pageType="trust"
>
  <div class="max-w-4xl mx-auto space-y-6 text-sm font-medium text-slate-800 leading-relaxed">
    <div class="neo-card p-6 sm:p-8 bg-white space-y-4">
      <h2 class="text-xl font-black text-black">Acceptance of Terms</h2>
      <p class="text-slate-700">
        By accessing and using JobAlertHub, you agree to these terms. If you do not agree, please do not use the directory.
      </p>
      <h2 class="text-xl font-black text-black">Permitted Use</h2>
      <p class="text-slate-700">
        You may use this directory to discover public career communities for personal, non-commercial job seeking. Automated scraping or bulk harvesting of directory data is prohibited.
      </p>
    </div>
  </div>
</DirectoryLayout>

---
import DirectoryLayout from "../layouts/DirectoryLayout.astro";
import { siteConfig } from "../config/site";

const pageTitle = `About JobAlertHub | ${siteConfig.name}`;
const pageDescription = "Learn about JobAlertHub, our mission to index public job alert communities, and our zero-hallucination standards.";
---

<DirectoryLayout
  heading="About JobAlertHub"
  subheading="An independent, fact-first public directory of job alert channels, career communities, and hiring networks."
  breadcrumbs={[{ name: "About", item: "/about/" }]}
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/about/"
  pageType="trust"
>
  <div class="max-w-4xl mx-auto space-y-8 text-sm sm:text-base font-medium text-slate-800 leading-relaxed">
    <div class="neo-card p-6 sm:p-8 bg-white space-y-4">
      <h2 class="text-2xl font-black text-black">Our Mission</h2>
      <p class="text-slate-700">
        Job hunting in modern tech, healthcare, finance, and remote industries is increasingly distributed across real-time messaging communities: Discord servers, Telegram channels, and WhatsApp hiring groups.
      </p>
      <p class="text-slate-700">
        JobAlertHub was built to create a clean, searchable, and validated index of these public communities across 14 target markets (13 countries + Worldwide/Remote).
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="neo-card-yellow p-6 space-y-3">
        <h3 class="text-lg font-black text-black">Fact-First Standards</h3>
        <p class="text-xs font-medium text-black/80 leading-relaxed">
          We do not generate synthetic member counts, fake ratings, or promotional testimonials. Every community listed has a publicly verifiable invite URL and real-world origin.
        </p>
      </div>

      <div class="neo-card-mint p-6 space-y-3">
        <h3 class="text-lg font-black text-black">Proactive Safety</h3>
        <p class="text-xs font-medium text-black/80 leading-relaxed">
          We maintain automated filters against recruitment fraud, fee-demanding schemes, and task optimization scams to protect job seekers from exploitation.
        </p>
      </div>
    </div>

    <div class="neo-card p-6 sm:p-8 bg-white space-y-4">
      <h2 class="text-2xl font-black text-black">Independent Public Service</h2>
      <p class="text-slate-700">
        JobAlertHub is an independent directory. We are not affiliated with, endorsed by, or operated by Discord Inc., Telegram FZ-LLC, or WhatsApp LLC.
      </p>
      <div class="pt-4 flex flex-wrap gap-3">
        <a href="/jobs/" class="neo-button bg-[#FEF08A] hover:bg-[#FDE047] text-black px-5 py-2.5 text-xs font-black">
          Browse All Job Groups &rarr;
        </a>
        <a href="/how-we-verify/" class="neo-button bg-white hover:bg-slate-100 text-black px-5 py-2.5 text-xs font-black">
          Our Verification Process
        </a>
      </div>
    </div>
  </div>
</DirectoryLayout>

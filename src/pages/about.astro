---
import DirectoryLayout from "../layouts/DirectoryLayout.astro";
import { siteConfig } from "../config/site";
import { generateOrganizationSchema } from "../lib/schema";

const organizationSchema = generateOrganizationSchema();
---

<DirectoryLayout
  heading={`About ${siteConfig.name}`}
  subheading="Building a clean, structured, and scam-free catalog for discovering public job alert communities."
  breadcrumbs={[
    { name: "All Jobs", item: "/jobs" },
    { name: "About", item: "/about" },
  ]}
  canonicalPath="/about"
  jsonLd={organizationSchema}
>
  <div class="max-w-4xl mx-auto space-y-8 text-sm sm:text-base font-medium text-slate-800 leading-relaxed">
    <section class="neo-card p-6 sm:p-8 space-y-3 bg-white">
      <div class="inline-block bg-[#FEF08A] px-2 py-0.5 border-2 border-black text-[10px] font-black uppercase tracking-wider shadow-[1.5px_1.5px_0px_0px_#000] mb-2">
        PURPOSE
      </div>
      <h2 class="text-2xl font-black text-black">Our Mission</h2>
      <p class="font-bold text-slate-700">
        Job hunting has moved into real-time community channels across WhatsApp, Telegram, and Discord. Job seekers in premium English-speaking markets (USA, UK, Canada, and Australia) rely on these groups for early vacancy alerts, recruiter direct messages, and peer networking.
      </p>
      <p class="font-bold text-slate-700">
        <strong>{siteConfig.name}</strong> was created to catalog legitimate, active job alert groups while aggressively rejecting upfront-fee scams, task optimization schemes, and dead invite links.
      </p>
    </section>

    <section class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-8">
      <div class="neo-card-yellow p-6 text-center">
        <div class="text-3xl font-black text-black mb-1">0%</div>
        <div class="text-xs font-black uppercase tracking-wider text-black">Fake Metrics</div>
        <p class="text-xs font-bold text-slate-700 mt-1">We never fabricate member counts or reviews.</p>
      </div>

      <div class="neo-card-mint p-6 text-center">
        <div class="text-3xl font-black text-black mb-1">100%</div>
        <div class="text-xs font-black uppercase tracking-wider text-black">Public Channels</div>
        <p class="text-xs font-bold text-slate-700 mt-1">Only active, publicly accessible group links.</p>
      </div>

      <div class="neo-card-purple p-6 text-center">
        <div class="text-3xl font-black text-black mb-1">Strict</div>
        <div class="text-xs font-black uppercase tracking-wider text-black">Scam Filtering</div>
        <p class="text-xs font-bold text-slate-700 mt-1">Automated rejection of upfront-fee schemes.</p>
      </div>
    </section>

    <section class="neo-card p-6 sm:p-8 space-y-3 bg-white">
      <div class="inline-block bg-[#A7F3D0] px-2 py-0.5 border-2 border-black text-[10px] font-black uppercase tracking-wider shadow-[1.5px_1.5px_0px_0px_#000] mb-2">
        OPERATIONS
      </div>
      <h2 class="text-2xl font-black text-black">How We Operate</h2>
      <p class="font-bold text-slate-700">
        We combine automated search grounding, daily link health checks, and strict human moderation to index public career channels, developer servers, and regional hiring groups. Job seekers can browse completely free of charge.
      </p>
    </section>
  </div>
</DirectoryLayout>

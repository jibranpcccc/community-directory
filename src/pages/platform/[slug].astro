---
import DirectoryLayout from "../../layouts/DirectoryLayout.astro";
import CommunityGrid from "../../components/CommunityGrid.astro";
import { platforms, type PlatformConfig } from "../../config/platforms";
import { getCommunitiesByPlatform } from "../../lib/communities";
import { generateCollectionPageSchema } from "../../lib/schema";

export async function getStaticPaths() {
  return platforms
    .filter((p) => p.isConfigured)
    .map((platform) => ({
      params: { slug: platform.id },
      props: { platform },
    }));
}

interface Props {
  platform: PlatformConfig;
}

const { platform } = Astro.props;
const communities = getCommunitiesByPlatform(platform.id);

const schema = generateCollectionPageSchema(
  `${platform.name} Communities & Groups`,
  platform.description,
  `/platform/${platform.id}`,
  communities
);
---

<DirectoryLayout
  heading={`${platform.name} Communities`}
  subheading={`Explore publicly discoverable ${platform.name} channels, groups, and servers catalogued across diverse topics.`}
  breadcrumbs={[
    { name: "Platforms", item: "/#platforms" },
    { name: platform.name, item: `/platform/${platform.id}` },
  ]}
  canonicalPath={`/platform/${platform.id}`}
  jsonLd={schema}
  noindex={communities.length === 0}
>
  <!-- Non-Affiliation Notice -->
  <div class="mb-6 neo-card p-4 bg-white text-xs font-bold text-black">
    ℹ️ <strong>Platform Notice:</strong> This page indexes publicly discoverable {platform.name} invite links and channels. We are an independent directory not affiliated with or endorsed by {platform.name}.
  </div>

  <div class="flex items-center justify-between mb-4">
    <span class="text-xs font-bold text-black">
      Showing <strong class="underline font-black">{communities.length}</strong> listed communities on {platform.name}
    </span>
  </div>

  <CommunityGrid
    communities={communities}
    emptyTitle={`No ${platform.name} communities found`}
    emptyMessage={`We have not indexed any public ${platform.name} communities yet. Submit one today!`}
  />
</DirectoryLayout>

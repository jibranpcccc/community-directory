---
import DirectoryLayout from "../../layouts/DirectoryLayout.astro";
import CommunityGrid from "../../components/CommunityGrid.astro";
import SafetyNotice from "../../components/SafetyNotice.astro";
import { siteConfig } from "../../config/site";
import { platforms, type PlatformConfig } from "../../config/platforms";
import { getCommunitiesByPlatform } from "../../lib/communities";
import { generateCollectionPageSchema } from "../../lib/schema";

export async function getStaticPaths() {
  return platforms
    .filter((p) => p.isConfigured)
    .map((platform) => ({
      params: { slug: platform.id },
      props: { platform },
    }));
}

interface Props {
  platform: PlatformConfig;
}

const { platform } = Astro.props;
const communities = getCommunitiesByPlatform(platform.id);

const platformNoun =
  platform.id === "discord"
    ? "Servers"
    : platform.id === "telegram"
    ? "Channels & Groups"
    : "Groups";

const schema = generateCollectionPageSchema(
  `Job Alert ${platform.name} ${platformNoun}`,
  `Browse verified ${platform.name} job groups, employment channels, and career communities across the US, UK, Canada, and Australia.`,
  `/platform/${platform.id}`,
  communities
);
---

<DirectoryLayout
  heading={`Job Alert ${platform.name} ${platformNoun}`}
  subheading={`Explore publicly discoverable ${platform.name} job alert channels, hiring groups, and career communities.`}
  breadcrumbs={[
    { name: "All Jobs", item: "/jobs" },
    { name: `${platform.name} Jobs`, item: `/platform/${platform.id}` },
  ]}
  canonicalPath={`/platform/${platform.id}`}
  jsonLd={schema}
  pageType="platform"
  noindex={communities.length < siteConfig.platformMinCommunities}
>
  <!-- Non-Affiliation Platform Notice -->
  <div class="mb-6 neo-card p-4 bg-white text-xs font-bold text-black flex items-center gap-2">
    <span>??</span>
    <span>
      <strong>Platform Notice:</strong> This directory catalogues publicly discoverable {platform.name} job alert links. We are an independent directory and are not affiliated with or endorsed by {platform.name}.
    </span>
  </div>

  <div class="flex items-center justify-between mb-4">
    <span class="text-xs font-bold text-black">
      Showing <strong class="underline font-black">{communities.length}</strong> {communities.length === 1 ? 'community' : 'communities'} on {platform.name}
    </span>
  </div>

  <div class="space-y-8">
    <CommunityGrid
      communities={communities}
      emptyTitle={`No active ${platform.name} job communities currently published`}
      emptyMessage="JobAlertHub continues checking public communities automatically. Verified communities will appear here once they pass publication gates."
    />

    <!-- Safety Notice -->
    <SafetyNotice type="job-warning" />
  </div>
</DirectoryLayout>

---
import DirectoryLayout from "../../layouts/DirectoryLayout.astro";
import CommunityGrid from "../../components/CommunityGrid.astro";
import SafetyNotice from "../../components/SafetyNotice.astro";
import { platforms, type PlatformConfig } from "../../config/platforms";
import { getCommunitiesByPlatform } from "../../lib/communities";
import { generateCollectionPageSchema } from "../../lib/schema";

export async function getStaticPaths() {
  return platforms
    .filter((p) => p.isConfigured)
    .map((platform) => ({
      params: { slug: platform.id },
      props: { platform },
    }));
}

interface Props {
  platform: PlatformConfig;
}

const { platform } = Astro.props;
const communities = getCommunitiesByPlatform(platform.id);

const schema = generateCollectionPageSchema(
  `${platform.name} Job Groups & Alert Channels`,
  `Browse verified ${platform.name} job groups, employment channels, and career communities across the US, UK, Canada, and Australia.`,
  `/platform/${platform.id}`,
  communities
);
---

<DirectoryLayout
  heading={`${platform.name} Job Groups`}
  subheading={`Explore publicly discoverable ${platform.name} job alert channels, hiring groups, and career servers.`}
  breadcrumbs={[
    { name: "All Jobs", item: "/jobs" },
    { name: `${platform.name} Jobs`, item: `/platform/${platform.id}` },
  ]}
  canonicalPath={`/platform/${platform.id}`}
  jsonLd={schema}
  noindex={communities.length === 0}
>
  <!-- Non-Affiliation Notice -->
  <div class="mb-6 neo-card p-4 bg-white text-xs font-bold text-black">
    ⚠️ <strong>Platform Notice:</strong> This directory catalogues publicly discoverable {platform.name} job alert links and channels. We are an independent directory not affiliated with or endorsed by {platform.name} or Meta.
  </div>

  <div class="flex items-center justify-between mb-4">
    <span class="text-xs font-bold text-black">
      Showing <strong class="underline font-black">{communities.length}</strong> listed job groups on {platform.name}
    </span>
  </div>

  <div class="space-y-8">
    <CommunityGrid
      communities={communities}
      emptyTitle={`No ${platform.name} job groups found`}
      emptyMessage={`We have not indexed any public ${platform.name} job communities yet. Submit one today!`}
    />

    <SafetyNotice type="job-warning" />
  </div>
</DirectoryLayout>

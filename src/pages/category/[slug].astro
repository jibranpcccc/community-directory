---
import DirectoryLayout from "../../layouts/DirectoryLayout.astro";
import CommunityGrid from "../../components/CommunityGrid.astro";
import SafetyNotice from "../../components/SafetyNotice.astro";
import { categories, type CategoryConfig } from "../../config/categories";
import { getCommunitiesByCategory } from "../../lib/communities";
import { generateCollectionPageSchema } from "../../lib/schema";

export async function getStaticPaths() {
  return categories.map((cat) => ({
    params: { slug: cat.slug },
    props: { category: cat },
  }));
}

interface Props {
  category: CategoryConfig;
}

const { category } = Astro.props;
const communities = getCommunitiesByCategory(category.slug);

const schema = generateCollectionPageSchema(
  `${category.name} Communities`,
  category.description,
  `/category/${category.slug}`,
  communities
);
---

<DirectoryLayout
  heading={`${category.name} Communities`}
  subheading={category.description}
  breadcrumbs={[
    { name: "Categories", item: "/#categories" },
    { name: category.name, item: `/category/${category.slug}` },
  ]}
  canonicalPath={`/category/${category.slug}`}
  jsonLd={schema}
  noindex={communities.length === 0}
>
  <!-- Subcategories & Tags Bar -->
  <div class="mb-6 neo-card p-5 bg-white">
    <div class="text-xs font-black text-black uppercase tracking-wider mb-3">
      Popular Topics & Subcategories
    </div>
    <div class="flex flex-wrap gap-2">
      {
        category.subcategories.map((sub) => (
          <span class="rounded-lg border-2 border-black bg-[#FEF9C3] px-3 py-1 text-xs font-black text-black shadow-[1.5px_1.5px_0px_0px_#000]">
            {sub}
          </span>
        ))
      }
    </div>
  </div>

  <!-- Mandatory Financial Risk Disclaimer for Crypto / Forex categories -->
  {
    category.financialDisclaimerRequired && (
      <div class="mb-6">
        <SafetyNotice type="financial" />
      </div>
    )
  }

  <!-- Listings Header -->
  <div class="flex items-center justify-between mb-4">
    <span class="text-xs font-bold text-black">
      Showing <strong class="underline font-black">{communities.length}</strong> listed communities in {category.name}
    </span>
  </div>

  <CommunityGrid
    communities={communities}
    emptyTitle={`No ${category.name} communities yet`}
    emptyMessage="Be the first to submit a public community in this category."
  />
</DirectoryLayout>

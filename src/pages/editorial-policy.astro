---
import DirectoryLayout from "../layouts/DirectoryLayout.astro";
import { siteConfig } from "../config/site";

const pageTitle = `Editorial Policy & Listing Guidelines | ${siteConfig.name}`;
const pageDescription = "Our editorial guidelines, inclusion standards, and review policies for public job alert communities.";
---

<DirectoryLayout
  heading="Editorial Policy & Standards"
  subheading="Our criteria for indexing, evaluating, maintaining, and removing public job communities."
  breadcrumbs={[{ name: "Editorial Policy", item: "/editorial-policy/" }]}
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/editorial-policy/"
  pageType="trust"
>
  <div class="max-w-4xl mx-auto space-y-8 text-sm sm:text-base font-medium text-slate-800 leading-relaxed">
    <div class="neo-card p-6 sm:p-8 bg-white space-y-4">
      <h2 class="text-xl sm:text-2xl font-black text-black">Inclusion Criteria</h2>
      <p class="text-slate-700">To be listed on JobAlertHub, a community must meet all of the following requirements:</p>
      <ul class="list-disc pl-5 space-y-2 text-xs sm:text-sm font-bold text-slate-800">
        <li>Must have a functional, non-expired public invite link.</li>
        <li>Must focus primarily on career opportunities, hiring alerts, internships, or industry networking.</li>
        <li>Must serve one of our 14 target employment markets (13 countries + Worldwide/Remote: US, UK, CA, AU, IN, DE, NL, SG, AE, PH, NZ, IE, ZA, or GLOBAL).</li>
        <li>Must not require upfront fees or subscriptions to access basic job alerts.</li>
        <li>Must not promote task scams, crypto investment recruitment, or multi-level marketing (MLM).</li>
      </ul>
    </div>

    <div class="neo-card p-6 sm:p-8 bg-white space-y-4">
      <h2 class="text-xl sm:text-2xl font-black text-black">Automated Revalidation & Removal</h2>
      <p class="text-slate-700">
        Directory listings are checked daily for link health. Communities with broken links or spam reports are placed on probation and automatically unpublished if unresolved within 48 hours.
      </p>
    </div>
  </div>
</DirectoryLayout>

---
import DirectoryLayout from "../layouts/DirectoryLayout.astro";
import { siteConfig } from "../config/site";

const pageTitle = `Report a Listing | ${siteConfig.name}`;
const pageDescription = "Report broken invite links, inactive channels, spam, or scam activity.";
---

<DirectoryLayout
  heading="Report a Community Listing"
  subheading="Report broken links, expired invites, task scams, or inactive communities for rapid moderation review."
  breadcrumbs={[{ name: "Report Listing", item: "/report/" }]}
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/report/"
  noindex={true}
  pageType="utility"
>
  <div class="max-w-2xl mx-auto">
    <form
      name="community-report"
      method="POST"
      action="/report-success/"
      data-netlify="true"
      netlify-honeypot="bot-field"
      class="rounded-3xl border-[3px] border-black bg-white p-6 sm:p-8 shadow-[6px_6px_0px_0px_#000] space-y-6"
    >
      <input type="hidden" name="form-name" value="community-report" />

      <p class="hidden">
        <label>Don't fill this out if you're human: <input name="bot-field" /></label>
      </p>

      <div>
        <label for="communityUrl" class="block text-xs font-black uppercase tracking-wider text-black mb-1.5">
          Community Directory URL or Invite Link <span class="text-rose-600">*</span>
        </label>
        <input
          type="text"
          name="communityUrl"
          id="communityUrl"
          required
          placeholder="e.g. /group/example or https://discord.gg/..."
          class="w-full rounded-xl border-2 border-black py-2.5 px-4 text-sm font-medium text-black placeholder:text-slate-400 shadow-[2px_2px_0px_0px_#000] focus:outline-none focus:shadow-[4px_4px_0px_0px_#000]"
        />
      </div>

      <div>
        <label for="reason" class="block text-xs font-black uppercase tracking-wider text-black mb-1.5">
          Report Reason <span class="text-rose-600">*</span>
        </label>
        <select
          name="reason"
          id="reason"
          required
          class="w-full rounded-xl border-2 border-black bg-[#FAF8F5] py-2.5 px-4 text-xs font-bold text-black shadow-[2px_2px_0px_0px_#000] focus:bg-white focus:outline-none"
        >
          <option value="broken-link">Broken / Expired Invite Link</option>
          <option value="scam-fraud">Job Scam / Upfront Fee / Crypto Task Scheme</option>
          <option value="inactive">Inactive / Abandoned Community</option>
          <option value="wrong-niche">Not a Job / Career Group</option>
          <option value="other">Other Issue</option>
        </select>
      </div>

      <div>
        <label for="details" class="block text-xs font-black uppercase tracking-wider text-black mb-1.5">
          Additional Details
        </label>
        <textarea
          name="details"
          id="details"
          rows="3"
          placeholder="Describe the issue observed..."
          class="w-full rounded-xl border-2 border-black py-2.5 px-4 text-sm font-medium text-black placeholder:text-slate-400 shadow-[2px_2px_0px_0px_#000] focus:outline-none focus:shadow-[4px_4px_0px_0px_#000]"
        ></textarea>
      </div>

      <div>
        <button
          type="submit"
          class="neo-button w-full bg-[#FECDD3] hover:bg-[#FDA4AF] text-black py-3 px-6 text-sm font-black"
        >
          Submit Report for Review &rarr;
        </button>
      </div>
    </form>
  </div>
</DirectoryLayout>

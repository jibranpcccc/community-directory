---
import DirectoryLayout from "../../layouts/DirectoryLayout.astro";
import CommunityCard from "../../components/CommunityCard.astro";
import SafetyNotice from "../../components/SafetyNotice.astro";
import EmptyState from "../../components/EmptyState.astro";
import { JOB_TYPES, getJobTypeConfig } from "../../config/jobTypes";
import { getCommunitiesByJobType } from "../../lib/communities";
import { siteConfig } from "../../config/site";
import { generateCollectionPageSchema } from "../../lib/schema";
import { getIndexability, isCommunityIndexWorthyForTaxonomy } from "../../lib/seo";

export async function getStaticPaths() {
  return JOB_TYPES.map((jt) => ({
    params: { type: jt.slug },
  }));
}

const { type } = Astro.params;
const jobTypeConfig = getJobTypeConfig(type as string);

if (!jobTypeConfig) {
  return Astro.redirect("/404/");
}

const communities = getCommunitiesByJobType(jobTypeConfig.slug);
const seoEligible = communities.filter(isCommunityIndexWorthyForTaxonomy);
const isIndexable = getIndexability("job-type", seoEligible.length);

const isRemoteJobs = jobTypeConfig.slug === "remote-jobs";

const pageTitle = isRemoteJobs
  ? `Remote Job Communities & Hiring Groups | ${siteConfig.name}`
  : `${jobTypeConfig.name} Job Alert Communities | ${siteConfig.name}`;

const heading = isRemoteJobs
  ? "Remote Work Communities & Hiring Groups"
  : `${jobTypeConfig.name} Job Communities`;

const subheading = isRemoteJobs
  ? "Explore public community groups and hiring hubs dedicated to remote work, distributed teams, and telecommute employment opportunities."
  : jobTypeConfig.description;

const pageDescription = isRemoteJobs
  ? "Explore public Telegram, Discord, and WhatsApp communities specializing in remote job vacancies, work-from-home positions, and telecommute hiring."
  : `Discover public Telegram, Discord, and WhatsApp communities sharing ${jobTypeConfig.name} job alerts and openings.`;

const collectionSchema = generateCollectionPageSchema(
  heading,
  pageDescription,
  `/job-type/${jobTypeConfig.slug}/`,
  communities
);
---

<DirectoryLayout
  heading={heading}
  subheading={subheading}
  breadcrumbs={[{ name: jobTypeConfig.name, item: `/job-type/${jobTypeConfig.slug}/` }]}
  title={pageTitle}
  description={pageDescription}
  canonicalPath={`/job-type/${jobTypeConfig.slug}/`}
  jsonLd={collectionSchema}
  noindex={!isIndexable}
  pageType="job-type"
>
  {
    communities.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mb-10">
        {communities.map((comm) => (
          <CommunityCard community={comm} />
        ))}
      </div>
    ) : (
      <div class="mb-10">
        <EmptyState
          title={`No ${jobTypeConfig.name} Communities Found`}
          message="We haven't indexed any active communities specifically tagged with this work arrangement yet."
          resetUrl="/jobs/"
        />
      </div>
    )
  }

  <SafetyNotice type="job-warning" />
</DirectoryLayout>

---
import DirectoryLayout from "../../layouts/DirectoryLayout.astro";
import FilterBar from "../../components/FilterBar.astro";
import CommunityGrid from "../../components/CommunityGrid.astro";
import SafetyNotice from "../../components/SafetyNotice.astro";
import { siteConfig } from "../../config/site";
import { JOB_TYPES } from "../../config/jobTypes";
import { getCommunitiesByJobType } from "../../lib/communities";
import { filterAndSortCommunities } from "../../lib/filters";
import { generateCollectionPageSchema } from "../../lib/schema";
import type { PlatformId, VerificationStatus, SortOption, CountryCode } from "../../types/community";

export function getStaticPaths() {
  return JOB_TYPES.map((jt) => ({
    params: { type: jt.slug },
    props: { jobTypeConfig: jt },
  }));
}

const { type } = Astro.params;
const { jobTypeConfig } = Astro.props;

const search = Astro.url.searchParams.get("search") || undefined;
const countryCode = (Astro.url.searchParams.get("countryCode") as CountryCode) || undefined;
const platform = (Astro.url.searchParams.get("platform") as PlatformId) || undefined;
const verificationStatus = (Astro.url.searchParams.get("verificationStatus") as VerificationStatus) || undefined;
const sort = (Astro.url.searchParams.get("sort") as SortOption) || "newest";

const jobCommunities = getCommunitiesByJobType(jobTypeConfig.slug);
const filtered = filterAndSortCommunities(
  jobCommunities,
  { search, countryCode, platform, verificationStatus },
  sort
);

const schema = generateCollectionPageSchema(
  `${jobTypeConfig.name} Job Alert Groups`,
  jobTypeConfig.description,
  `/job-type/${jobTypeConfig.slug}`,
  filtered
);

const noindex = jobCommunities.length < siteConfig.jobTypeMinCommunities;
---

<DirectoryLayout
  heading={`${jobTypeConfig.name} Job Alert Groups`}
  subheading={jobTypeConfig.description}
  breadcrumbs={[
    { name: "All Jobs", item: "/jobs" },
    { name: jobTypeConfig.name, item: `/job-type/${jobTypeConfig.slug}` },
  ]}
  canonicalPath={`/job-type/${jobTypeConfig.slug}`}
  noindex={noindex}
  pageType="job-type"
  jsonLd={schema}
>
  <!-- Filter Bar -->
  <FilterBar
    currentFilters={{ search, countryCode, platform, verificationStatus }}
    currentSort={sort}
    showCategoryFilter={true}
  />

  <div class="flex items-center justify-between mb-4 mt-6">
    <span class="text-xs font-bold text-black">
      Showing <strong class="underline font-black">{filtered.length}</strong> {filtered.length === 1 ? 'community' : 'communities'} for {jobTypeConfig.name}
    </span>
  </div>

  <div class="space-y-8">
    <CommunityGrid
      communities={filtered}
      emptyTitle={`No ${jobTypeConfig.name.toLowerCase()} groups currently published`}
      emptyMessage="JobAlertHub continues checking public communities automatically. Verified communities will appear here once they pass publication gates."
    />

    <!-- Safety Notice -->
    <SafetyNotice type="job-warning" />
  </div>
</DirectoryLayout>

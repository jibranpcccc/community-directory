---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { siteConfig } from "../config/site";
import { generateBreadcrumbSchema } from "../lib/schema";

const breadcrumbs = [
  { name: "Home", item: "/" },
  { name: "Contact", item: "/contact" },
];

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs);
---

<BaseLayout
  title="Contact Us"
  description={`Get in touch with the ${siteConfig.name} team for inquiries, feedback, or partnerships.`}
  canonicalPath="/contact"
  pageType="utility"
  noindex={true}
  jsonLd={breadcrumbSchema}
>
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <Breadcrumbs items={breadcrumbs} />

    <header class="mb-8 p-6 sm:p-8 rounded-3xl border-[3px] border-black bg-[#FEF08A] shadow-[5px_5px_0px_0px_#000]">
      <div class="inline-block bg-white px-2 py-0.5 border-2 border-black text-[10px] font-black uppercase tracking-wider shadow-[1.5px_1.5px_0px_0px_#000] mb-2">
        GET IN TOUCH
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-black tracking-tight">
        Contact the Team
      </h1>
      <p class="mt-2 text-sm font-bold text-black/80 leading-relaxed">
        Have questions, suggestions, or partnership opportunities? Send us a message below.
      </p>
    </header>

    <!-- Contact Form with Netlify Form integration -->
    <form
      name="contact"
      method="POST"
      action="/submit-success"
      data-netlify="true"
      netlify-honeypot="bot-field"
      class="rounded-3xl border-[3px] border-black bg-white p-6 sm:p-8 shadow-[6px_6px_0px_0px_#000] space-y-6"
    >
      <input type="hidden" name="form-name" value="contact" />
      <p class="hidden">
        <label>
          Don't fill this out if you're human: <input name="bot-field" />
        </label>
      </p>

      <div>
        <label for="name" class="block text-xs font-black uppercase tracking-wider text-black mb-1.5">
          Your Name <span class="text-rose-500">*</span>
        </label>
        <input
          type="text"
          name="name"
          id="name"
          required
          placeholder="Jane Doe"
          class="w-full rounded-xl border-2 border-black px-4 py-2.5 text-sm font-medium text-black placeholder:text-slate-500 shadow-[2px_2px_0px_0px_#000] focus:outline-none focus:shadow-[4px_4px_0px_0px_#000]"
        />
      </div>

      <div>
        <label for="email" class="block text-xs font-black uppercase tracking-wider text-black mb-1.5">
          Email Address <span class="text-rose-500">*</span>
        </label>
        <input
          type="email"
          name="email"
          id="email"
          required
          placeholder="jane@example.com"
          class="w-full rounded-xl border-2 border-black px-4 py-2.5 text-sm font-medium text-black placeholder:text-slate-500 shadow-[2px_2px_0px_0px_#000] focus:outline-none focus:shadow-[4px_4px_0px_0px_#000]"
        />
      </div>

      <div>
        <label for="subject" class="block text-xs font-black uppercase tracking-wider text-black mb-1.5">
          Subject <span class="text-rose-500">*</span>
        </label>
        <select
          name="subject"
          id="subject"
          required
          class="w-full rounded-xl border-2 border-black bg-[#FAF8F5] px-4 py-2.5 text-sm font-bold text-black shadow-[2px_2px_0px_0px_#000] focus:bg-white focus:outline-none"
        >
          <option value="">Select a topic...</option>
          <option value="general">General Inquiry</option>
          <option value="feedback">Feedback or Suggestion</option>
          <option value="partnership">Partnership Opportunity</option>
          <option value="press">Press or Media</option>
          <option value="other">Other</option>
        </select>
      </div>

      <div>
        <label for="message" class="block text-xs font-black uppercase tracking-wider text-black mb-1.5">
          Message <span class="text-rose-500">*</span>
        </label>
        <textarea
          name="message"
          id="message"
          rows="5"
          required
          placeholder="How can we help?"
          class="w-full rounded-xl border-2 border-black px-4 py-2.5 text-sm font-medium text-black placeholder:text-slate-500 shadow-[2px_2px_0px_0px_#000] focus:outline-none focus:shadow-[4px_4px_0px_0px_#000]"
        ></textarea>
      </div>

      <div>
        <button
          type="submit"
          class="neo-button w-full bg-[#FEF08A] hover:bg-[#FDE047] py-3.5 text-sm font-black text-black shadow-[4px_4px_0px_0px_#000]"
        >
          Send Message &rarr;
        </button>
      </div>
    </form>
  </div>
</BaseLayout>

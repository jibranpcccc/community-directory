---
import DirectoryLayout from "../layouts/DirectoryLayout.astro";
import { siteConfig } from "../config/site";

const pageTitle = `Contact Us | ${siteConfig.name}`;
const pageDescription = "Get in touch with the JobAlertHub directory maintainers.";
---

<DirectoryLayout
  heading="Contact Maintainers"
  subheading="Reach out for directory inquiries, listing adjustments, or moderation assistance."
  breadcrumbs={[{ name: "Contact", item: "/contact/" }]}
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/contact/"
  noindex={true}
  pageType="utility"
>
  <div class="max-w-xl mx-auto neo-card p-6 sm:p-8 bg-white space-y-4 text-xs font-bold text-black">
    <p class="text-sm font-medium text-slate-700">
      Have questions or want to update a listing? You can submit an issue on our GitHub repository or file a report.
    </p>
    <div class="pt-2 flex flex-col gap-3">
      <a href="/report/" class="neo-button bg-[#FECDD3] hover:bg-[#FDA4AF] text-black px-4 py-2.5 text-center font-black">
        Report a Community Listing &rarr;
      </a>
      <a href="/submit/" class="neo-button bg-[#A7F3D0] hover:bg-[#6EE7B7] text-black px-4 py-2.5 text-center font-black">
        Submit a New Community &rarr;
      </a>
    </div>
  </div>
</DirectoryLayout>

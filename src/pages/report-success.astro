---
import DirectoryLayout from "../layouts/DirectoryLayout.astro";
---

<DirectoryLayout
  heading="Listing Report Received"
  subheading="Thank you for helping keep our directory safe and accurate."
  canonicalPath="/report-success/"
  noindex={true}
  pageType="utility"
>
  <div class="max-w-xl mx-auto neo-card-yellow p-8 text-center space-y-4">
    <h2 class="text-2xl font-black text-black">Report Received</h2>
    <p class="text-xs sm:text-sm font-bold text-black/80 leading-relaxed">
      Our moderation desk will review the flagged listing and take appropriate action.
    </p>
    <div class="pt-4">
      <a href="/jobs/" class="neo-button bg-white hover:bg-slate-100 text-black px-6 py-2.5 text-xs font-black">
        Return to Directory &rarr;
      </a>
    </div>
  </div>
</DirectoryLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Report Received"
  description="Thank you for reporting an issue with a job community listing."
  canonicalPath="/report-success"
  pageType="utility"
  noindex={true}
>
  <div class="max-w-xl mx-auto px-4 py-16 sm:py-24 text-center">
    <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl border-[3px] border-black bg-[#FEF08A] text-black shadow-[3px_3px_0px_0px_#000] mb-6">
      <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
      </svg>
    </div>

    <h1 class="text-2xl sm:text-4xl font-black text-black tracking-tight mb-3">
      Report Received
    </h1>

    <p class="text-sm font-bold text-slate-700 leading-relaxed mb-8">
      Thank you for helping keep JobAlertHub safe and accurate. Our automated and editorial review processes will inspect the reported link.
    </p>

    <div class="flex justify-center gap-4">
      <a
        href="/"
        class="neo-btn bg-[#FEF08A] hover:bg-[#FDE047] px-5 py-2.5 text-xs font-black text-black border-2 border-black shadow-[2px_2px_0px_0px_#000]"
      >
        Back to Home
      </a>
      <a
        href="/jobs"
        class="neo-btn bg-white hover:bg-slate-50 px-5 py-2.5 text-xs font-black text-black border-2 border-black shadow-[2px_2px_0px_0px_#000]"
      >
        Browse Job Groups
      </a>
    </div>
  </div>
</BaseLayout>

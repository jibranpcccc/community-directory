---
import DirectoryLayout from "../layouts/DirectoryLayout.astro";
import SafetyNotice from "../components/SafetyNotice.astro";
import { generateFAQSchema } from "../lib/schema";

const faqSchema = generateFAQSchema([
  {
    question: "Does listing a community mean CommunityHub endorses it?",
    answer: "No. Our directory catalogs publicly discoverable online communities. Listing a community does not constitute endorsement of its administrators, members, viewpoints, or products.",
  },
  {
    question: "How do I protect my crypto wallet and credentials in communities?",
    answer: "Never share seed phrases or private keys. Legitimate support staff will never ask for credentials. Beware of unsolicited direct messages (DMs) from impersonators and avoid downloading unverified files.",
  },
  {
    question: "Are trading signals and financial advice guaranteed?",
    answer: "No. Be skeptical of groups promising guaranteed profits or risk-free returns. All financial markets involve risk of capital loss.",
  },
  {
    question: "How do I report a compromised or unsafe community?",
    answer: "If you encounter a listing that promotes illegal activities, malware, or scams, submit an immediate report via our /report page for moderator review.",
  },
]);
---

<DirectoryLayout
  heading="Community Safety Guide"
  subheading="Essential safety practices for joining and participating in public online communities."
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "Safety Guide", item: "/safety" },
  ]}
  canonicalPath="/safety"
  jsonLd={faqSchema}
>
  <div class="max-w-4xl mx-auto space-y-8 text-sm sm:text-base font-medium text-slate-800 leading-relaxed">
    <SafetyNotice type="general" />

    <section class="neo-card p-6 sm:p-8 space-y-4 bg-white">
      <div class="inline-block bg-[#FEF08A] px-2 py-0.5 border-2 border-black text-[10px] font-black uppercase tracking-wider shadow-[1.5px_1.5px_0px_0px_#000]">
        RULE #1
      </div>
      <h2 class="text-xl sm:text-2xl font-black text-black">
        1. Directory Inclusion Is Not Endorsement
      </h2>
      <p class="text-slate-700 font-bold">
        Our directory catalogs publicly discoverable online communities. Listing a Telegram channel, Discord server, or WhatsApp group does not mean we endorse its administrators, members, viewpoints, or products. Always perform your own due diligence before trusting advice or making transactions.
      </p>
    </section>

    <section class="neo-card-coral p-6 sm:p-8 space-y-4">
      <div class="inline-block bg-white px-2 py-0.5 border-2 border-black text-[10px] font-black uppercase tracking-wider shadow-[1.5px_1.5px_0px_0px_#000]">
        SECURITY BEST PRACTICES
      </div>
      <h2 class="text-xl sm:text-2xl font-black text-black">
        2. Protect Sensitive Credentials & Wallets
      </h2>
      <ul class="list-disc pl-5 space-y-2 text-black font-bold">
        <li><strong>Never share seed phrases or private keys:</strong> Legitimate administrators and support staff will NEVER ask for your wallet recovery phrases or passwords.</li>
        <li><strong>Beware of direct messages (DMs):</strong> Scammers frequently impersonate admins in public channels and initiate private chats offering "support" or "exclusive deals".</li>
        <li><strong>Do not download unverified files:</strong> Executable files (.exe, .scr, .bat, macro-enabled documents) shared in chat groups may contain infostealers or remote access trojans.</li>
      </ul>
    </section>

    <section class="neo-card-yellow p-6 sm:p-8 space-y-4">
      <div class="inline-block bg-white px-2 py-0.5 border-2 border-black text-[10px] font-black uppercase tracking-wider shadow-[1.5px_1.5px_0px_0px_#000]">
        FINANCIAL DISCLAIMER
      </div>
      <h2 class="text-xl sm:text-2xl font-black text-black">
        3. Financial Market & Investment Warnings
      </h2>
      <p class="text-black font-bold">
        Be extremely skeptical of groups promising guaranteed profits, 100% win rates, or "risk-free" trading signals. Financial markets involve substantial risk of capital loss. No community or signal provider can guarantee returns.
      </p>
      <SafetyNotice type="financial" />
    </section>

    <section class="neo-card-mint p-6 sm:p-8 space-y-4">
      <div class="inline-block bg-white px-2 py-0.5 border-2 border-black text-[10px] font-black uppercase tracking-wider shadow-[1.5px_1.5px_0px_0px_#000]">
        COMMUNITY INTEGRITY
      </div>
      <h2 class="text-xl sm:text-2xl font-black text-black">
        4. Reporting Suspicious or Compromised Communities
      </h2>
      <p class="text-black font-bold">
        If you encounter a community listed on our site that has been compromised, promotes illegal activities, or distributes malware, please submit an immediate report using our <a href="/report" class="font-black underline text-black">Report Listing form</a>.
      </p>
    </section>
  </div>
</DirectoryLayout>

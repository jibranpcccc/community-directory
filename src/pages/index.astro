---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchBox from "../components/SearchBox.astro";
import CommunityGrid from "../components/CommunityGrid.astro";
import PlatformBadge from "../components/PlatformBadge.astro";
import CategoryBadge from "../components/CategoryBadge.astro";
import VerificationBadge from "../components/VerificationBadge.astro";
import SafetyNotice from "../components/SafetyNotice.astro";
import AdPlaceholder from "../components/AdPlaceholder.astro";
import { categories } from "../config/categories";
import { ENABLED_COUNTRIES } from "../config/countries";
import { platforms } from "../config/platforms";
import { siteConfig } from "../config/site";
import { formatDate } from "../lib/dates";
import {
  getFeaturedCommunities,
  getRecentlyAdded,
  getRecentlyChecked,
  getDatasetStats,
} from "../lib/communities";
import { generateWebSiteSchema, generateOrganizationSchema } from "../lib/schema";

const stats = getDatasetStats();
const featuredListings = getFeaturedCommunities(6);
const recentAdditions = getRecentlyAdded(6);
const recentlyChecked = getRecentlyChecked(5);

const webSiteSchema = generateWebSiteSchema();
const organizationSchema = generateOrganizationSchema();
---

<BaseLayout
  title={`${siteConfig.tagline} — USA, UK, Canada & Australia`}
  description={siteConfig.description}
  canonicalPath="/"
  jsonLd={[webSiteSchema, organizationSchema]}
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-[#FAF8F5] py-12 sm:py-20 border-b-[3px] border-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Neo-Brutalist Hero Card -->
      <div class="relative rounded-3xl border-[3px] border-black bg-[#A7F3D0] p-6 sm:p-12 shadow-[6px_6px_0px_0px_#000] overflow-hidden">
        <!-- Playful Sticker Badge in Top Right -->
        <div class="absolute -right-4 -top-4 sm:right-8 sm:top-6 rotate-6 z-10">
          <div class="neo-badge bg-[#FEF08A] text-black px-4 py-2 text-xs sm:text-sm font-black border-2 border-black shadow-[3px_3px_0px_0px_#000] tracking-wider uppercase">
            ? TIER-1 JOB ALERTS ?
          </div>
        </div>

        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 rounded-lg border-2 border-black bg-white px-3 py-1 text-xs font-black text-black shadow-[2px_2px_0px_0px_#000] mb-6">
            <span class="h-2.5 w-2.5 rounded-full bg-[#10B981] border border-black"></span>
            ZERO FAKE METRICS • PUBLIC DIRECTORY
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-black mb-6 leading-tight">
            FIND ACTIVE <br class="hidden sm:inline" />
            <span class="bg-[#FEF08A] px-2 py-0.5 border-2 border-black shadow-[3px_3px_0px_0px_#000] inline-block mt-1">
              JOB ALERT GROUPS
            </span>
          </h1>

          <p class="text-sm sm:text-base font-bold text-black/80 leading-relaxed mb-8 max-w-xl">
            {siteConfig.subheadline}
          </p>

          <!-- Search Box -->
          <div class="mb-6">
            <SearchBox size="lg" />
          </div>

          <!-- Country Quick Filters -->
          <div class="flex flex-wrap items-center gap-2.5 pt-2">
            <span class="text-xs font-black text-black uppercase tracking-wider">Target Countries:</span>
            {ENABLED_COUNTRIES.map((c) => (
              <a
                href={`/country/${c.slug}`}
                class="neo-button bg-white hover:bg-[#FEF08A] text-black px-3 py-1 text-xs font-black"
              >
                {c.flag} {c.shortName}
              </a>
            ))}
            <a
              href="/job-type/remote-jobs"
              class="neo-button bg-[#FEF08A] hover:bg-[#FDE047] text-black px-3 py-1 text-xs font-black"
            >
              ?? Remote Jobs
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Factual Dataset Counters -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-6">
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
      <div class="neo-card-yellow p-5 text-center">
        <div class="text-3xl sm:text-4xl font-black text-black">{stats.totalPublished}</div>
        <div class="text-xs font-black text-black uppercase tracking-wider mt-1">Active Job Communities</div>
      </div>
      <div class="neo-card-mint p-5 text-center">
        <div class="text-3xl sm:text-4xl font-black text-black">{ENABLED_COUNTRIES.length}</div>
        <div class="text-xs font-black text-black uppercase tracking-wider mt-1">Target Countries</div>
      </div>
      <div class="neo-card-purple p-5 text-center">
        <div class="text-3xl sm:text-4xl font-black text-black">3</div>
        <div class="text-xs font-black text-black uppercase tracking-wider mt-1">Chat Platforms</div>
      </div>
      <div class="neo-card-coral p-5 text-center">
        <div class="text-3xl sm:text-4xl font-black text-black">4 Tiers</div>
        <div class="text-xs font-black text-black uppercase tracking-wider mt-1">Verification Standards</div>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-16">
    <!-- Ad Space Leaderboard (Optional) -->
    <AdPlaceholder format="leaderboard" />

    <!-- Country Hubs Section -->
    <section id="countries" class="scroll-mt-20">
      <div class="flex items-center justify-between mb-6">
        <div>
          <div class="inline-block bg-[#BAE6FD] px-2 py-0.5 border-2 border-black text-[10px] font-black uppercase tracking-wider shadow-[1.5px_1.5px_0px_0px_#000] mb-1.5">
            LOCATION HUBS
          </div>
          <h2 class="text-2xl sm:text-3xl font-black text-black tracking-tight">Browse by Country</h2>
          <p class="text-xs font-bold text-slate-600 mt-1">Explore job channels and communities by advertising market</p>
        </div>
        <a href="/jobs" class="neo-button bg-white hover:bg-slate-100 text-black px-3.5 py-1.5 text-xs font-black">
          View all jobs ?
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {
          ENABLED_COUNTRIES.map((c) => (
            <a
              href={`/country/${c.slug}`}
              class="neo-card p-6 bg-white hover:bg-[#FEF9C3] flex flex-col justify-between group transition-all"
            >
              <div>
                <div class="text-3xl mb-2">{c.flag}</div>
                <h3 class="text-lg font-black text-black group-hover:underline mb-1">
                  {c.name}
                </h3>
                <p class="text-xs font-medium text-slate-600 mb-4">
                  Job alerts and recruitment groups across major {c.shortName} metropolitan hubs.
                </p>
              </div>

              <div class="pt-3 border-t-2 border-black/10 flex items-center justify-between text-xs font-black text-black">
                <span>Explore {c.shortName}</span>
                <span>?</span>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Featured Communities Section (Only shown if listings exist) -->
    {
      featuredListings.length > 0 && (
        <section>
          <div class="flex items-center justify-between mb-6">
            <div>
              <div class="inline-block bg-[#FEF08A] px-2 py-0.5 border-2 border-black text-[10px] font-black uppercase tracking-wider shadow-[1.5px_1.5px_0px_0px_#000] mb-1.5">
                HAND-PICKED
              </div>
              <h2 class="text-2xl sm:text-3xl font-black text-black tracking-tight">Featured Job Communities</h2>
              <p class="text-xs font-bold text-slate-600 mt-1">Verified communities sharing job alerts</p>
            </div>
            <a href="/jobs" class="neo-button bg-white hover:bg-slate-100 text-black px-3.5 py-1.5 text-xs font-black">
              Browse all ?
            </a>
          </div>
          <CommunityGrid communities={featuredListings} />
        </section>
      )
    }

    <!-- Job Categories Section -->
    <section id="categories" class="scroll-mt-20">
      <div class="flex items-center justify-between mb-6">
        <div>
          <div class="inline-block bg-[#A7F3D0] px-2 py-0.5 border-2 border-black text-[10px] font-black uppercase tracking-wider shadow-[1.5px_1.5px_0px_0px_#000] mb-1.5">
            JOB ROLES & DISCIPLINES
          </div>
          <h2 class="text-2xl sm:text-3xl font-black text-black tracking-tight">Browse by Job Category</h2>
          <p class="text-xs font-bold text-slate-600 mt-1">Find alert groups organized by industry and career track</p>
        </div>
        <a href="/jobs" class="neo-button bg-white hover:bg-slate-100 text-black px-3.5 py-1.5 text-xs font-black">
          View all ?
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {
          categories.map((cat, idx) => {
            const cardClasses = [
              "neo-card-yellow",
              "neo-card-mint",
              "neo-card-purple",
              "neo-card-coral",
              "neo-card",
            ][idx % 5];

            return (
              <a
                href={`/category/${cat.slug}`}
                class={`group relative flex flex-col justify-between p-5 ${cardClasses}`}
              >
                <div>
                  <h3 class="text-lg font-black text-black group-hover:underline mb-2">
                    {cat.name}
                  </h3>
                  <p class="text-xs font-medium text-black/80 leading-relaxed mb-4">
                    {cat.description}
                  </p>
                </div>

                <div class="flex flex-wrap gap-1.5 pt-3 border-t-2 border-black/10">
                  {cat.subcategories.slice(0, 3).map((sub) => (
                    <span class="rounded-md border border-black bg-white px-2 py-0.5 text-[11px] font-bold text-black shadow-[1px_1px_0px_0px_#000]">
                      {sub}
                    </span>
                  ))}
                </div>
              </a>
            );
          })
        }
      </div>
    </section>

    <!-- Platform Cards Section -->
    <section id="platforms" class="scroll-mt-20">
      <div class="flex items-center justify-between mb-6">
        <div>
          <div class="inline-block bg-[#DDD6FE] px-2 py-0.5 border-2 border-black text-[10px] font-black uppercase tracking-wider shadow-[1.5px_1.5px_0px_0px_#000] mb-1.5">
            CHANNELS & NETWORKS
          </div>
          <h2 class="text-2xl sm:text-3xl font-black text-black tracking-tight">Explore by Platform</h2>
          <p class="text-xs font-bold text-slate-600 mt-1">Filter public job channels by messaging network</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {
          platforms
            .filter((p) => p.isConfigured)
            .map((plat) => {
              const bgClass =
                plat.id === "discord"
                  ? "neo-card-purple"
                  : plat.id === "telegram"
                  ? "neo-card bg-[#BAE6FD]"
                  : "neo-card-mint";

              return (
                <a
                  href={`/platform/${plat.id}`}
                  class={`group p-6 ${bgClass}`}
                >
                  <div class="flex items-center justify-between mb-3">
                    <span class="text-xl font-black text-black group-hover:underline">
                      {plat.name} Jobs
                    </span>
                    <span class="rounded-lg border-2 border-black bg-white px-2.5 py-0.5 text-xs font-black text-black shadow-[1.5px_1.5px_0px_0px_#000]">
                      {stats.platforms[plat.id] || 0} listings
                    </span>
                  </div>
                  <p class="text-xs font-medium text-black/80 leading-relaxed">
                    {plat.description}
                  </p>
                </a>
              );
            })
        }
      </div>
    </section>

    <!-- Recently Added Communities (Only shown if listings exist) -->
    {
      recentAdditions.length > 0 && (
        <section>
          <div class="flex items-center justify-between mb-6">
            <div>
              <div class="inline-block bg-[#FED7AA] px-2 py-0.5 border-2 border-black text-[10px] font-black uppercase tracking-wider shadow-[1.5px_1.5px_0px_0px_#000] mb-1.5">
                FRESH LISTINGS
              </div>
              <h2 class="text-2xl sm:text-3xl font-black text-black tracking-tight">Recently Added Job Groups</h2>
              <p class="text-xs font-bold text-slate-600 mt-1">New additions catalogued in the directory</p>
            </div>
            <a href="/jobs" class="neo-button bg-white hover:bg-slate-100 text-black px-3.5 py-1.5 text-xs font-black">
              Browse all ?
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {recentAdditions.map((comm) => (
              <a
                href={`/group/${comm.slug}`}
                class="neo-card flex items-center justify-between p-4 bg-white hover:bg-[#FEF9C3]"
              >
                <div class="min-w-0 pr-3">
                  <h3 class="text-sm font-black text-black truncate">
                    {comm.title}
                  </h3>
                  <div class="flex items-center gap-2 mt-2">
                    <PlatformBadge platform={comm.platform} size="sm" />
                    <CategoryBadge category={comm.category} size="sm" />
                  </div>
                </div>
                <span class="text-xs font-black text-black shrink-0 underline">
                  View ?
                </span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <!-- Job Seeker Safety Notice Banner -->
    <SafetyNotice type="job-warning" />

    <!-- Submission CTA Banner -->
    <section class="rounded-3xl border-[3px] border-black bg-[#FEF08A] p-8 sm:p-12 text-black text-center shadow-[6px_6px_0px_0px_#000]">
      <div class="inline-block bg-white px-3 py-1 border-2 border-black text-xs font-black uppercase tracking-wider shadow-[2px_2px_0px_0px_#000] mb-4">
        ? FREE SUBMISSIONS ?
      </div>
      <h2 class="text-2xl sm:text-4xl font-black mb-3">
        Manage a Public Job Alert Community?
      </h2>
      <p class="text-black/80 max-w-xl mx-auto text-xs sm:text-sm font-bold leading-relaxed mb-6">
        Submit your community to be catalogued in the job alert directory. Every submission is reviewed before publication. Verification status is shown transparently on each listing.
      </p>
      <a
        href="/submit"
        class="neo-button bg-[#A7F3D0] hover:bg-[#6EE7B7] px-6 py-3 text-sm font-black text-black shadow-[4px_4px_0px_0px_#000]"
      >
        Submit a Job Community for Free ?
      </a>
    </section>
  </div>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchBox from "../components/SearchBox.astro";
import CommunityGrid from "../components/CommunityGrid.astro";
import PlatformBadge from "../components/PlatformBadge.astro";
import CategoryBadge from "../components/CategoryBadge.astro";
import VerificationBadge from "../components/VerificationBadge.astro";
import SafetyNotice from "../components/SafetyNotice.astro";
import { categories } from "../config/categories";
import { ENABLED_COUNTRIES } from "../config/countries";
import { platforms } from "../config/platforms";
import { siteConfig } from "../config/site";
import { formatDate } from "../lib/dates";
import {
  getFeaturedCommunities,
  getRecentlyAdded,
  getRecentlyChecked,
  getDatasetStats,
} from "../lib/communities";
import { generateWebSiteSchema, generateOrganizationSchema } from "../lib/schema";

const stats = getDatasetStats();
const featuredListings = getFeaturedCommunities(6);
const recentAdditions = getRecentlyAdded(6);
const recentlyChecked = getRecentlyChecked(5);

const webSiteSchema = generateWebSiteSchema();
const organizationSchema = generateOrganizationSchema();
---

<BaseLayout
  title={`${siteConfig.name} — ${siteConfig.tagline}`}
  description={siteConfig.description}
  canonicalPath="/"
  pageType="home"
  jsonLd={[webSiteSchema, organizationSchema]}
>
  <!-- 1. Hero Section -->
  <section class="relative overflow-hidden bg-[#FAF8F5] py-12 sm:py-20 border-b-[3px] border-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative rounded-3xl border-[3px] border-black bg-[#A7F3D0] p-6 sm:p-12 shadow-[6px_6px_0px_0px_#000] overflow-hidden">
        <!-- Top Right Badge -->
        <div class="absolute -right-4 -top-4 sm:right-8 sm:top-6 rotate-3 z-10">
          <div class="neo-badge bg-[#FEF08A] text-black px-4 py-2 text-xs sm:text-sm font-black border-2 border-black shadow-[3px_3px_0px_0px_#000] tracking-wider uppercase">
            ? TIER-1 JOB ALERTS
          </div>
        </div>

        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 rounded-lg border-2 border-black bg-white px-3 py-1 text-xs font-black text-black shadow-[2px_2px_0px_0px_#000] mb-6">
            <span class="h-2.5 w-2.5 rounded-full bg-[#10B981] border border-black"></span>
            ZERO FAKE METRICS • PUBLIC DIRECTORY
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-black mb-6 leading-tight">
            Find Active <br class="hidden sm:inline" />
            <span class="bg-[#FEF08A] px-2 py-0.5 border-2 border-black shadow-[3px_3px_0px_0px_#000] inline-block mt-1">
              Job Alert Groups
            </span>
          </h1>

          <p class="text-sm sm:text-lg font-bold text-black/90 leading-relaxed mb-8 max-w-2xl">
            Discover public Discord servers, Telegram channels, and WhatsApp groups sharing hiring alerts and career opportunities across the United States, United Kingdom, Canada, and Australia.
          </p>

          <!-- Primary CTA & Quick Links -->
          <div class="flex flex-wrap items-center gap-4 mb-6">
            <a
              href="/jobs"
              class="neo-btn inline-flex items-center gap-2 bg-[#FEF08A] hover:bg-[#FDE047] text-black font-black px-6 py-3.5 text-sm sm:text-base border-[3px] border-black shadow-[4px_4px_0px_0px_#000]"
            >
              <span>Browse Job Groups</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
            </a>
            <a
              href="/how-we-verify"
              class="neo-btn inline-flex items-center gap-2 bg-white hover:bg-slate-50 text-black font-black px-5 py-3.5 text-sm border-2 border-black shadow-[3px_3px_0px_0px_#000]"
            >
              <span>How We Verify</span>
            </a>
          </div>

          <!-- Secondary Trust Signals -->
          <div class="flex flex-wrap items-center gap-4 text-xs font-black text-black">
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-emerald-700" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
              Links Automatically Rechecked
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-emerald-700" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
              US • UK • Canada • Australia
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-emerald-700" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
              Strict Scam & Fraud Screening
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Dynamic Live Stats Bar -->
  <section class="border-b-[3px] border-black bg-white py-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
        <div class="p-3 border-2 border-black rounded-2xl bg-[#FEF9C3] shadow-[3px_3px_0px_0px_#000]">
          <div class="text-2xl font-black text-black">{stats.totalPublished}</div>
          <div class="text-xs font-black uppercase text-slate-700">Active Communities</div>
        </div>
        <div class="p-3 border-2 border-black rounded-2xl bg-[#BAE6FD] shadow-[3px_3px_0px_0px_#000]">
          <div class="text-2xl font-black text-black">{stats.countriesCount}</div>
          <div class="text-xs font-black uppercase text-slate-700">Countries Covered</div>
        </div>
        <div class="p-3 border-2 border-black rounded-2xl bg-[#DDD6FE] shadow-[3px_3px_0px_0px_#000]">
          <div class="text-2xl font-black text-black">{stats.platformsCount}</div>
          <div class="text-xs font-black uppercase text-slate-700">Messaging Platforms</div>
        </div>
        <div class="p-3 border-2 border-black rounded-2xl bg-[#A7F3D0] shadow-[3px_3px_0px_0px_#000]">
          <div class="text-2xl font-black text-black">24h</div>
          <div class="text-xs font-black uppercase text-slate-700">Recheck Frequency</div>
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-16">
    <!-- 3. Current Active Groups Section (Dynamic Inventory) -->
    {
      featuredListings.length > 0 && (
        <section>
          <div class="flex items-center justify-between mb-6">
            <div>
              <div class="inline-block bg-[#FEF08A] px-2 py-0.5 border-2 border-black text-[10px] font-black uppercase tracking-wider shadow-[1.5px_1.5px_0px_0px_#000] mb-1.5">
                ACTIVE LISTINGS
              </div>
              <h2 class="text-2xl sm:text-3xl font-black text-black tracking-tight">Active Job Communities</h2>
              <p class="text-xs font-bold text-slate-600 mt-1">Verified communities sharing real employment openings</p>
            </div>
            <a href="/jobs" class="neo-button bg-white hover:bg-slate-100 text-black px-3.5 py-1.5 text-xs font-black">
              Browse all &rarr;
            </a>
          </div>
          <CommunityGrid communities={featuredListings} />
        </section>
      )
    }

    <!-- 4. Browse by Country -->
    <section id="countries" class="scroll-mt-20">
      <div class="flex items-center justify-between mb-6">
        <div>
          <div class="inline-block bg-[#BAE6FD] px-2 py-0.5 border-2 border-black text-[10px] font-black uppercase tracking-wider shadow-[1.5px_1.5px_0px_0px_#000] mb-1.5">
            GEOGRAPHIC FOCUS
          </div>
          <h2 class="text-2xl sm:text-3xl font-black text-black tracking-tight">Browse by Country</h2>
          <p class="text-xs font-bold text-slate-600 mt-1">Tier-1 English-speaking hiring markets</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {
          ENABLED_COUNTRIES.map((c) => {
            const count = stats.countries[c.code] || 0;
            return (
              <a
                href={`/country/${c.slug}`}
                class="neo-card p-5 bg-white hover:bg-[#FEF9C3] flex flex-col justify-between"
              >
                <div>
                  <div class="text-3xl mb-2">{c.flag}</div>
                  <h3 class="text-lg font-black text-black mb-1">{c.name}</h3>
                  <p class="text-xs font-medium text-slate-600">
                    {c.cities.slice(0, 3).join(", ")}
                  </p>
                </div>
                <div class="mt-4 pt-3 border-t-2 border-black/10 flex items-center justify-between text-xs font-bold">
                  <span class="text-black">{count} {count === 1 ? 'community' : 'communities'}</span>
                  <span class="font-black text-black">&rarr;</span>
                </div>
              </a>
            );
          })
        }
      </div>
    </section>

    <!-- 5. Browse by Job Category -->
    <section id="categories" class="scroll-mt-20">
      <div class="flex items-center justify-between mb-6">
        <div>
          <div class="inline-block bg-[#A7F3D0] px-2 py-0.5 border-2 border-black text-[10px] font-black uppercase tracking-wider shadow-[1.5px_1.5px_0px_0px_#000] mb-1.5">
            JOB DISCIPLINES
          </div>
          <h2 class="text-2xl sm:text-3xl font-black text-black tracking-tight">Browse by Job Category</h2>
          <p class="text-xs font-bold text-slate-600 mt-1">Specialized employment tracks and industry channels</p>
        </div>
        <a href="/jobs" class="neo-button bg-white hover:bg-slate-100 text-black px-3.5 py-1.5 text-xs font-black">
          View all &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {
          categories.map((cat, idx) => {
            const count = stats.categories[cat.slug] || 0;
            const cardClasses = [
              "neo-card-yellow",
              "neo-card-mint",
              "neo-card-purple",
              "neo-card-coral",
              "neo-card",
            ][idx % 5];

            return (
              <a
                href={`/category/${cat.slug}`}
                class={`group relative flex flex-col justify-between p-5 ${cardClasses}`}
              >
                <div>
                  <div class="flex items-center justify-between mb-2">
                    <h3 class="text-lg font-black text-black group-hover:underline">
                      {cat.name}
                    </h3>
                    <span class="text-xs font-black px-2 py-0.5 bg-white border border-black rounded shadow-[1px_1px_0px_0px_#000]">
                      {count}
                    </span>
                  </div>
                  <p class="text-xs font-medium text-black/80 leading-relaxed mb-4">
                    {cat.description}
                  </p>
                </div>

                <div class="flex flex-wrap gap-1.5 pt-3 border-t-2 border-black/10">
                  {cat.subcategories.slice(0, 3).map((sub) => (
                    <span class="rounded-md border border-black bg-white px-2 py-0.5 text-[11px] font-bold text-black shadow-[1px_1px_0px_0px_#000]">
                      {sub}
                    </span>
                  ))}
                </div>
              </a>
            );
          })
        }
      </div>
    </section>

    <!-- 6. Browse by Platform -->
    <section id="platforms" class="scroll-mt-20">
      <div class="flex items-center justify-between mb-6">
        <div>
          <div class="inline-block bg-[#DDD6FE] px-2 py-0.5 border-2 border-black text-[10px] font-black uppercase tracking-wider shadow-[1.5px_1.5px_0px_0px_#000] mb-1.5">
            MESSAGING PLATFORMS
          </div>
          <h2 class="text-2xl sm:text-3xl font-black text-black tracking-tight">Explore by Platform</h2>
          <p class="text-xs font-bold text-slate-600 mt-1">Public career channels organized by communication app</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {
          platforms
            .filter((p) => p.isConfigured)
            .map((plat) => {
              const bgClass =
                plat.id === "discord"
                  ? "neo-card-purple"
                  : plat.id === "telegram"
                  ? "neo-card bg-[#BAE6FD]"
                  : "neo-card-mint";

              return (
                <a
                  href={`/platform/${plat.id}`}
                  class={`group p-6 ${bgClass}`}
                >
                  <div class="flex items-center justify-between mb-3">
                    <span class="text-xl font-black text-black group-hover:underline">
                      {plat.name} Jobs
                    </span>
                    <span class="rounded-lg border-2 border-black bg-white px-2.5 py-0.5 text-xs font-black text-black shadow-[1.5px_1.5px_0px_0px_#000]">
                      {stats.platforms[plat.id] || 0} listings
                    </span>
                  </div>
                  <p class="text-xs font-medium text-black/80 leading-relaxed">
                    {plat.description}
                  </p>
                </a>
              );
            })
        }
      </div>
    </section>

    <!-- 7. How JobAlertHub Works -->
    <section class="neo-card p-6 sm:p-10 bg-white">
      <div class="inline-block bg-[#FEF08A] px-2 py-0.5 border-2 border-black text-[10px] font-black uppercase tracking-wider shadow-[1.5px_1.5px_0px_0px_#000] mb-3">
        METHODOLOGY
      </div>
      <h2 class="text-2xl sm:text-3xl font-black text-black tracking-tight mb-2">How JobAlertHub Works</h2>
      <p class="text-xs sm:text-sm font-bold text-slate-700 mb-8 max-w-2xl">
        JobAlertHub uses automated discovery and validation pipelines to maintain an active directory of public job communities.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="p-4 border-2 border-black rounded-xl bg-[#FEF9C3] shadow-[2px_2px_0px_0px_#000]">
          <div class="font-black text-lg text-black mb-1">1. Discovery</div>
          <p class="text-xs font-medium text-slate-800">
            Public search indexing identifies publicly listed community links across Telegram, Discord, and WhatsApp.
          </p>
        </div>
        <div class="p-4 border-2 border-black rounded-xl bg-[#BAE6FD] shadow-[2px_2px_0px_0px_#000]">
          <div class="font-black text-lg text-black mb-1">2. Validation</div>
          <p class="text-xs font-medium text-slate-800">
            Automated health engines verify that invite links are active, not expired, and target US, UK, CA, or AU.
          </p>
        </div>
        <div class="p-4 border-2 border-black rounded-xl bg-[#DDD6FE] shadow-[2px_2px_0px_0px_#000]">
          <div class="font-black text-lg text-black mb-1">3. Safety Screening</div>
          <p class="text-xs font-medium text-slate-800">
            Scam filters screen against upfront fees, task optimization schemes, and crypto/forex recruitment fraud.
          </p>
        </div>
        <div class="p-4 border-2 border-black rounded-xl bg-[#A7F3D0] shadow-[2px_2px_0px_0px_#000]">
          <div class="font-black text-lg text-black mb-1">4. Revalidation</div>
          <p class="text-xs font-medium text-slate-800">
            Published communities are rechecked daily. Broken links or suspicious channels are auto-unpublished.
          </p>
        </div>
      </div>
    </section>

    <!-- 8. Verification & Trust Section -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="neo-card p-6 bg-white space-y-2">
        <div class="flex items-center justify-between mb-1">
          <h3 class="text-lg font-black text-black">Active Link</h3>
          <span class="rounded-lg border-2 border-black bg-[#A7F3D0] px-2.5 py-0.5 text-xs font-black text-black shadow-[1.5px_1.5px_0px_0px_#000]">Active</span>
        </div>
        <p class="text-xs font-medium text-slate-700 leading-relaxed">
          Indicates that the community invite was reachable during our latest automated check. It does not constitute an endorsement of job postings inside the group.
        </p>
      </div>

      <div class="neo-card p-6 bg-white space-y-2">
        <div class="flex items-center justify-between mb-1">
          <h3 class="text-lg font-black text-black">Source Confirmed</h3>
          <span class="rounded-lg border-2 border-black bg-[#BAE6FD] px-2.5 py-0.5 text-xs font-black text-black shadow-[1.5px_1.5px_0px_0px_#000]">Source Confirmed</span>
        </div>
        <p class="text-xs font-medium text-slate-700 leading-relaxed">
          Indicates that the exact community link or server ID was independently linked from an authoritative primary website or official organization page.
        </p>
      </div>
    </section>

    <!-- 9. Job Seeker Safety Notice -->
    <SafetyNotice type="job-warning" />
  </div>
</BaseLayout>

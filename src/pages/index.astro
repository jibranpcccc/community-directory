---
import BaseLayout from "../layouts/BaseLayout.astro";
import CommunityCard from "../components/CommunityCard.astro";
import SafetyNotice from "../components/SafetyNotice.astro";
import { getAllPublishedCommunities, getDatasetStats } from "../lib/communities";
import { siteConfig } from "../config/site";
import { ENABLED_COUNTRIES } from "../config/countries";
import { categories } from "../config/categories";
import { platforms } from "../config/platforms";
import { generateWebSiteSchema, generateOrganizationSchema } from "../lib/schema";

const communities = getAllPublishedCommunities();
const stats = getDatasetStats();

// Structured Data
const schemas = [
  generateWebSiteSchema(),
  generateOrganizationSchema(),
];

// Featured / Recent slice
const recentCommunities = communities.slice(0, 6);
---

<BaseLayout
  title={`${siteConfig.name} - ${siteConfig.tagline}`}
  description={siteConfig.description}
  canonicalPath="/"
  jsonLd={schemas}
  pageType="home"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-14 space-y-12 sm:space-y-16">
    <!-- 1. Hero Section -->
    <section class="neo-hero p-6 sm:p-10 md:p-12">
      <div class="max-w-3xl space-y-4 sm:space-y-6">
        <div class="inline-flex items-center gap-2 bg-[#A7F3D0] px-3 py-1 border-2 border-black rounded-lg text-xs font-black uppercase tracking-wider shadow-[2px_2px_0px_0px_#000]">
          <span>ZERO FAKE METRICS &bull; PUBLIC DIRECTORY</span>
        </div>

        <h1 class="text-3xl sm:text-5xl md:text-6xl font-black tracking-tight text-black leading-[1.08]">
          Discover Active Job Alert Communities
        </h1>

        <p class="text-sm sm:text-base md:text-lg font-bold text-black/85 leading-relaxed">
          Find public Discord servers, Telegram channels, and WhatsApp groups sharing job postings, career opportunities, and hiring alerts across 14 target markets (13 countries + Worldwide/Remote).
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <a
            href="/jobs/"
            class="neo-button bg-[#FEF08A] hover:bg-[#FDE047] text-black px-6 py-3 text-sm font-black"
          >
            Explore All Job Groups ({communities.length}) &rarr;
          </a>
          <a
            href="/how-we-verify/"
            class="neo-button bg-white hover:bg-slate-100 text-black px-5 py-3 text-sm font-black"
          >
            How We Verify Links
          </a>
        </div>
      </div>
    </section>

    <!-- 2. Trust & Methodology Bar -->
    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
      <div class="neo-card p-4 bg-white flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#BAE6FD] border-2 border-black font-black text-sm shadow-[2px_2px_0px_0px_#000]">
          14
        </div>
        <div>
          <div class="text-xs font-black uppercase tracking-wider text-black">Target Markets</div>
          <div class="text-xs font-bold text-slate-700">13 Countries + Worldwide/Remote</div>
        </div>
      </div>

      <div class="neo-card p-4 bg-white flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#A7F3D0] border-2 border-black font-black text-sm shadow-[2px_2px_0px_0px_#000]">
          100%
        </div>
        <div>
          <div class="text-xs font-black uppercase tracking-wider text-black">Public Discovery</div>
          <div class="text-xs font-bold text-slate-700">Zero private scrape access</div>
        </div>
      </div>

      <div class="neo-card p-4 bg-white flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#FEF08A] border-2 border-black font-black text-sm shadow-[2px_2px_0px_0px_#000]">
          24h
        </div>
        <div>
          <div class="text-xs font-black uppercase tracking-wider text-black">Automated Health</div>
          <div class="text-xs font-bold text-slate-700">Dead & expired links removed</div>
        </div>
      </div>

      <div class="neo-card p-4 bg-white flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#DDD6FE] border-2 border-black font-black text-sm shadow-[2px_2px_0px_0px_#000]">
          0
        </div>
        <div>
          <div class="text-xs font-black uppercase tracking-wider text-black">Scam Tolerance</div>
          <div class="text-xs font-bold text-slate-700">Upfront fees & task scams blocked</div>
        </div>
      </div>
    </section>

    <!-- 3. Target Countries Grid -->
    <section id="countries" class="scroll-mt-20">
      <div class="flex items-center justify-between mb-6">
        <div>
          <div class="inline-block bg-[#BAE6FD] px-2 py-0.5 border-2 border-black text-[10px] font-black uppercase tracking-wider shadow-[1.5px_1.5px_0px_0px_#000] mb-1.5">
            GEOGRAPHIC DIRECTORIES
          </div>
          <h2 class="text-2xl sm:text-3xl font-black text-black tracking-tight">Browse by Market</h2>
          <p class="text-xs font-bold text-slate-600 mt-1">Curated 14 target markets (13 regional countries + Worldwide/Remote)</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {
          ENABLED_COUNTRIES.map((c) => {
            const count = stats.countries[c.slug] || 0;
            return (
              <a
                href={`/country/${c.slug}/`}
                class="neo-card p-5 bg-white hover:bg-[#FAF8F5] transition-all group flex flex-col justify-between"
              >
                <div>
                  <div class="text-xs font-black uppercase tracking-wider mb-2 px-2 py-0.5 rounded border border-black bg-[#FEF08A] shadow-[1px_1px_0px_0px_#000] w-fit">
                    {c.code}
                  </div>
                  <h3 class="text-lg font-black text-black group-hover:underline">
                    {c.name}
                  </h3>
                  <p class="text-xs font-medium text-slate-600 mt-1">
                    {c.cities.slice(0, 3).join(", ")}
                  </p>
                </div>
                <div class="mt-4 pt-3 border-t-2 border-black/10 flex items-center justify-between">
                  <span class="text-xs font-black text-black">{count} active groups</span>
                  <span class="text-xs font-black text-black group-hover:translate-x-1 transition-transform">&rarr;</span>
                </div>
              </a>
            );
          })
        }
      </div>
    </section>

    <!-- 4. Recently Added / Tested Communities -->
    <section>
      <div class="flex items-center justify-between mb-6">
        <div>
          <div class="inline-block bg-[#FEF08A] px-2 py-0.5 border-2 border-black text-[10px] font-black uppercase tracking-wider shadow-[1.5px_1.5px_0px_0px_#000] mb-1.5">
            RECENTLY CHECKED
          </div>
          <h2 class="text-2xl sm:text-3xl font-black text-black tracking-tight">Latest Job Communities</h2>
          <p class="text-xs font-bold text-slate-600 mt-1">Public channels tested active in the directory</p>
        </div>
        <a href="/jobs/" class="neo-button bg-white hover:bg-slate-100 text-black px-3.5 py-1.5 text-xs font-black">
          View all ({communities.length}) &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {recentCommunities.map((comm) => (
          <CommunityCard community={comm} />
        ))}
      </div>
    </section>

    <!-- 5. Browse by Category -->
    <section id="categories" class="scroll-mt-20">
      <div class="flex items-center justify-between mb-6">
        <div>
          <div class="inline-block bg-[#A7F3D0] px-2 py-0.5 border-2 border-black text-[10px] font-black uppercase tracking-wider shadow-[1.5px_1.5px_0px_0px_#000] mb-1.5">
            JOB DISCIPLINES
          </div>
          <h2 class="text-2xl sm:text-3xl font-black text-black tracking-tight">Browse by Job Category</h2>
          <p class="text-xs font-bold text-slate-600 mt-1">Specialized employment tracks and industry channels</p>
        </div>
        <a href="/jobs/" class="neo-button bg-white hover:bg-slate-100 text-black px-3.5 py-1.5 text-xs font-black">
          View all &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {
          categories.map((cat, idx) => {
            const count = stats.categories[cat.slug] || 0;
            const cardClasses = [
              "neo-card-yellow",
              "neo-card-mint",
              "neo-card-purple",
              "neo-card-coral",
              "neo-card",
            ][idx % 5];

            return (
              <a
                href={`/category/${cat.slug}/`}
                class={`group relative flex flex-col justify-between p-5 ${cardClasses}`}
              >
                <div>
                  <div class="flex items-center justify-between mb-2">
                    <h3 class="text-lg font-black text-black group-hover:underline">
                      {cat.name}
                    </h3>
                    <span class="text-xs font-black px-2 py-0.5 bg-white border border-black rounded shadow-[1px_1px_0px_0px_#000]">
                      {count}
                    </span>
                  </div>
                  <p class="text-xs font-medium text-black/80 leading-relaxed mb-4">
                    {cat.description}
                  </p>
                </div>

                <div class="flex flex-wrap gap-1.5 pt-3 border-t-2 border-black/10">
                  {cat.subcategories.slice(0, 3).map((sub) => (
                    <span class="rounded-md border border-black bg-white px-2 py-0.5 text-[11px] font-bold text-black shadow-[1px_1px_0px_0px_#000]">
                      {sub}
                    </span>
                  ))}
                </div>
              </a>
            );
          })
        }
      </div>
    </section>

    <!-- 6. Browse by Platform -->
    <section id="platforms" class="scroll-mt-20">
      <div class="flex items-center justify-between mb-6">
        <div>
          <div class="inline-block bg-[#DDD6FE] px-2 py-0.5 border-2 border-black text-[10px] font-black uppercase tracking-wider shadow-[1.5px_1.5px_0px_0px_#000] mb-1.5">
            MESSAGING PLATFORMS
          </div>
          <h2 class="text-2xl sm:text-3xl font-black text-black tracking-tight">Explore by Platform</h2>
          <p class="text-xs font-bold text-slate-600 mt-1">Public career channels organized by communication app</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {
          platforms
            .filter((p) => p.isConfigured)
            .map((plat) => {
              const bgClass =
                plat.id === "discord"
                  ? "neo-card-purple"
                  : plat.id === "telegram"
                  ? "neo-card bg-[#BAE6FD]"
                  : "neo-card-mint";

              return (
                <a
                  href={`/platform/${plat.id}/`}
                  class={`group p-6 ${bgClass}`}
                >
                  <div class="flex items-center justify-between mb-3">
                    <span class="text-xl font-black text-black group-hover:underline">
                      {plat.name} Jobs
                    </span>
                    <span class="rounded-lg border-2 border-black bg-white px-2.5 py-0.5 text-xs font-black text-black shadow-[1.5px_1.5px_0px_0px_#000]">
                      {stats.platforms[plat.id] || 0} listings
                    </span>
                  </div>
                  <p class="text-xs font-medium text-black/80 leading-relaxed">
                    {plat.description}
                  </p>
                </a>
              );
            })
        }
      </div>
    </section>

    <!-- 7. How JobAlertHub Works -->
    <section class="neo-card p-6 sm:p-10 bg-white">
      <div class="inline-block bg-[#FEF08A] px-2 py-0.5 border-2 border-black text-[10px] font-black uppercase tracking-wider shadow-[1.5px_1.5px_0px_0px_#000] mb-3">
        METHODOLOGY
      </div>
      <h2 class="text-2xl sm:text-3xl font-black text-black tracking-tight mb-2">How JobAlertHub Works</h2>
      <p class="text-xs sm:text-sm font-bold text-slate-700 mb-8 max-w-2xl">
        JobAlertHub uses automated discovery and validation pipelines to maintain an active directory of public job communities.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="p-4 border-2 border-black rounded-xl bg-[#FEF9C3] shadow-[2px_2px_0px_0px_#000]">
          <div class="font-black text-lg text-black mb-1">1. Discovery</div>
          <p class="text-xs font-medium text-slate-800">
            Public search indexing identifies publicly listed community links across Telegram, Discord, and WhatsApp.
          </p>
        </div>
        <div class="p-4 border-2 border-black rounded-xl bg-[#BAE6FD] shadow-[2px_2px_0px_0px_#000]">
          <div class="font-black text-lg text-black mb-1">2. Validation</div>
          <p class="text-xs font-medium text-slate-800">
            Automated health engines verify that invite links are active, not expired, and target our 14 supported employment markets (13 countries + Worldwide/Remote).
          </p>
        </div>
        <div class="p-4 border-2 border-black rounded-xl bg-[#DDD6FE] shadow-[2px_2px_0px_0px_#000]">
          <div class="font-black text-lg text-black mb-1">3. Safety Screening</div>
          <p class="text-xs font-medium text-slate-800">
            Scam filters screen against upfront fees, task optimization schemes, and crypto/forex recruitment fraud.
          </p>
        </div>
        <div class="p-4 border-2 border-black rounded-xl bg-[#A7F3D0] shadow-[2px_2px_0px_0px_#000]">
          <div class="font-black text-lg text-black mb-1">4. Revalidation</div>
          <p class="text-xs font-medium text-slate-800">
            Published communities are rechecked daily. Broken links or suspicious channels are auto-unpublished.
          </p>
        </div>
      </div>
    </section>

    <!-- 8. Verification & Trust Section -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="neo-card p-6 bg-white space-y-2">
        <div class="flex items-center justify-between mb-1">
          <h3 class="text-lg font-black text-black">Active Link</h3>
          <span class="rounded-lg border-2 border-black bg-[#A7F3D0] px-2.5 py-0.5 text-xs font-black text-black shadow-[1.5px_1.5px_0px_0px_#000]">Active</span>
        </div>
        <p class="text-xs font-medium text-slate-700 leading-relaxed">
          Indicates that the community invite was reachable during our latest automated check. It does not constitute an endorsement of job postings inside the group.
        </p>
      </div>

      <div class="neo-card p-6 bg-white space-y-2">
        <div class="flex items-center justify-between mb-1">
          <h3 class="text-lg font-black text-black">Source Confirmed</h3>
          <span class="rounded-lg border-2 border-black bg-[#BAE6FD] px-2.5 py-0.5 text-xs font-black text-black shadow-[1.5px_1.5px_0px_0px_#000]">Source Confirmed</span>
        </div>
        <p class="text-xs font-medium text-slate-700 leading-relaxed">
          Indicates that the exact community link or server ID was independently linked from an authoritative primary website or official organization page.
        </p>
      </div>
    </section>

    <!-- 9. Job Seeker Safety Notice -->
    <SafetyNotice type="job-warning" />
  </div>
</BaseLayout>

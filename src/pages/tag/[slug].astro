---
import DirectoryLayout from "../../layouts/DirectoryLayout.astro";
import CommunityGrid from "../../components/CommunityGrid.astro";
import SafetyNotice from "../../components/SafetyNotice.astro";
import { siteConfig } from "../../config/site";
import { getAllTagsWithCounts, getCommunitiesByTag } from "../../lib/communities";
import { generateCollectionPageSchema } from "../../lib/schema";

export async function getStaticPaths() {
  const tagsWithCounts = getAllTagsWithCounts();

  return tagsWithCounts.map(({ tag }) => ({
    params: { slug: tag },
    props: { tag },
  }));
}

interface Props {
  tag: string;
}

const { tag } = Astro.props;
const communities = getCommunitiesByTag(tag);

const schema = generateCollectionPageSchema(
  `#${tag} Job Communities`,
  `Public job alert communities tagged with #${tag} across Telegram, WhatsApp, and Discord.`,
  `/tag/${tag}`,
  communities
);
---

<DirectoryLayout
  heading={`#${tag} Job Communities`}
  subheading={`Browse public online job communities tagged with #${tag}.`}
  breadcrumbs={[
    { name: "All Jobs", item: "/jobs" },
    { name: `#${tag}`, item: `/tag/${tag}` },
  ]}
  canonicalPath={`/tag/${tag}`}
  pageType="tag"
  noindex={true}
  jsonLd={schema}
>
  <div class="space-y-6">
    <!-- Tag Intent Clarification Banner -->
    <div class="neo-card-yellow p-4 text-xs font-bold text-black">
      <span>Tag Filter: </span>
      <span class="font-black">#{tag}</span>. Browse all public job channels matching this tag. For structured geographic or role listings, see our <a href="/jobs" class="underline font-black">All Jobs catalog</a>.
    </div>

    <!-- Group Grid -->
    <CommunityGrid
      communities={communities}
      emptyTitle={`No communities currently tagged #${tag}`}
      emptyDescription="We haven't indexed any active communities with this tag yet."
    />

    <!-- Safety Banner -->
    <SafetyNotice type="job-warning" />
  </div>
</DirectoryLayout>

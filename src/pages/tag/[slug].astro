---
import DirectoryLayout from "../../layouts/DirectoryLayout.astro";
import CommunityCard from "../../components/CommunityCard.astro";
import SafetyNotice from "../../components/SafetyNotice.astro";
import EmptyState from "../../components/EmptyState.astro";
import { getAllPublishedCommunities, getCommunitiesByTag } from "../../lib/communities";
import { siteConfig } from "../../config/site";
import { generateCollectionPageSchema } from "../../lib/schema";

export async function getStaticPaths() {
  const all = getAllPublishedCommunities();
  const tagSet = new Set<string>();
  for (const c of all) {
    if (Array.isArray(c.tags)) {
      for (const t of c.tags) {
        tagSet.add(t.toLowerCase());
      }
    }
  }

  return Array.from(tagSet).map((tag) => ({
    params: { slug: tag },
  }));
}

const { slug } = Astro.params;
const tagString = String(slug || "").toLowerCase();
const communities = getCommunitiesByTag(tagString);

const pageTitle = `Job Groups Tagged #${tagString} | ${siteConfig.name}`;
const pageDescription = `Browse public job alert channels and hiring communities tagged with #${tagString}.`;

const collectionSchema = generateCollectionPageSchema(
  `Job Groups Tagged #${tagString}`,
  pageDescription,
  `/tag/${tagString}/`,
  communities
);
---

<DirectoryLayout
  heading={`Communities Tagged #${tagString}`}
  subheading={`Public career communities and job alert channels tagged with #${tagString}.`}
  breadcrumbs={[{ name: `#${tagString}`, item: `/tag/${tagString}/` }]}
  title={pageTitle}
  description={pageDescription}
  canonicalPath={`/tag/${tagString}/`}
  jsonLd={collectionSchema}
  noindex={true}
  pageType="tag"
>
  {
    communities.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mb-10">
        {communities.map((comm) => (
          <CommunityCard community={comm} />
        ))}
      </div>
    ) : (
      <div class="mb-10">
        <EmptyState
          title={`No Communities Tagged #${tagString}`}
          message="No active communities with this specific tag are currently listed."
          resetUrl="/jobs/"
        />
      </div>
    )
  }

  <SafetyNotice type="job-warning" />
</DirectoryLayout>

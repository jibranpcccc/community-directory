---
import DirectoryLayout from "../../layouts/DirectoryLayout.astro";
import PlatformBadge from "../../components/PlatformBadge.astro";
import CategoryBadge from "../../components/CategoryBadge.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import VerificationBadge from "../../components/VerificationBadge.astro";
import SafetyNotice from "../../components/SafetyNotice.astro";
import { getAllPublishedCommunities } from "../../lib/communities";
import { getCountryByCode } from "../../config/countries";
import { getCategoryBySlug } from "../../config/categories";
import { getPlatformConfig } from "../../config/platforms";
import { formatDate } from "../../lib/dates";
import { siteConfig } from "../../config/site";
import { generateCommunityDetailSchema } from "../../lib/schema";
import { isCommunityIndexWorthy } from "../../lib/seo";
import type { Community } from "../../types/community";

export async function getStaticPaths() {
  const communities = getAllPublishedCommunities();
  return communities.map((community) => ({
    params: { slug: community.slug },
    props: { community },
  }));
}

interface Props {
  community: Community;
}

const { community } = Astro.props;

const country = getCountryByCode(community.countryCode);
const category = getCategoryBySlug(community.category);
const platformConfig = getPlatformConfig(community.platform);

const countryName = country ? country.name : "International";
const categoryName = category ? category.name : community.category;
const platformName = platformConfig ? platformConfig.name : community.platform;

// Factual SEO Metadata
const pageTitle = `${community.title} - ${categoryName} Job Group in ${countryName} | ${siteConfig.name}`;
const pageDescription =
  community.description && community.description.trim().length >= 50
    ? community.description.slice(0, 155)
    : `Discover ${community.title}, a public ${platformName} community sharing ${categoryName} job alerts in ${countryName}.`;

const detailSchema = generateCommunityDetailSchema(community);
const isIndexable = isCommunityIndexWorthy(community);

const breadcrumbs = [
  { name: "All Jobs", item: "/jobs/" },
  ...(country ? [{ name: country.name, item: `/country/${country.slug}/` }] : []),
  ...(category ? [{ name: category.name, item: `/category/${category.slug}/` }] : []),
  { name: community.title, item: `/group/${community.slug}/` },
];
---

<DirectoryLayout
  heading={community.title}
  subheading={`Public ${platformName} community for ${categoryName} in ${countryName}.`}
  breadcrumbs={breadcrumbs}
  title={pageTitle}
  description={pageDescription}
  canonicalPath={`/group/${community.slug}/`}
  jsonLd={detailSchema}
  pageType="group"
  noindex={!isIndexable}
>
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-10">
    <!-- Left 2 Columns: Main Listing Detail -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Key Metadata Card -->
      <div class="neo-card p-6 bg-white space-y-4">
        <div class="flex flex-wrap items-center gap-2">
          <PlatformBadge platform={community.platform} size="md" showLink={true} />
          {country && (
            <a
              href={`/country/${country.slug}/`}
              class="rounded-md border border-black bg-[#BAE6FD] px-2.5 py-1 text-xs font-black text-black shadow-[1px_1px_0px_0px_#000] hover:bg-[#7DD3FC]"
            >
              {country.shortName}
            </a>
          )}
          <CategoryBadge category={community.category} size="md" showLink={true} />
          <StatusBadge status={community.linkStatus} size="md" />
        </div>

        <h2 class="text-xl font-black text-black">About This Community</h2>

        {community.description ? (
          <p class="text-sm font-medium leading-relaxed text-slate-800 whitespace-pre-line">
            {community.description}
          </p>
        ) : (
          <p class="text-sm font-medium text-slate-500 italic">
            No public description provided by the community administrators.
          </p>
        )}

        <!-- Tags -->
        {community.tags && community.tags.length > 0 && (
          <div class="pt-4 border-t-2 border-black/10">
            <h3 class="text-xs font-black uppercase tracking-wider text-black mb-2">Community Tags</h3>
            <div class="flex flex-wrap gap-1.5">
              {community.tags.map((tag) => (
                <a
                  href={`/tag/${tag.toLowerCase()}/`}
                  class="rounded-md border border-black bg-[#FAF8F5] px-2.5 py-1 text-xs font-bold text-black hover:bg-[#FEF08A] transition-colors shadow-[1px_1px_0px_0px_#000]"
                >
                  #{tag}
                </a>
              ))}
            </div>
          </div>
        )}
      </div>

      <!-- Verification & Safety Notice for this Group -->
      <div class="neo-card p-6 bg-white space-y-3">
        <div class="flex items-center gap-2">
          <VerificationBadge status={community.verificationStatus} size="md" />
        </div>
        <p class="text-xs font-medium text-slate-700 leading-relaxed">
          {community.verificationStatus === "source-confirmed"
            ? "This community invite link was independently confirmed on an authoritative external website or directory index."
            : "This community was discovered from public directory listings. Its invite URL was checked by our automated verification engine."}
        </p>
        <p class="text-xs font-bold text-slate-600">
          Last health revalidation: <span class="font-black text-black">{formatDate(community.lastCheckedAt)}</span>
        </p>
      </div>
    </div>

    <!-- Right Column: Join Action & Direct Meta -->
    <div class="space-y-6">
      <div class="neo-card-yellow p-6 space-y-4">
        <h3 class="text-lg font-black text-black">Join Community</h3>
        <p class="text-xs font-medium text-black/80 leading-relaxed">
          Click below to open the public invite link in {platformName}.
        </p>

        <a
          href={community.inviteUrl}
          target="_blank"
          rel="nofollow noopener noreferrer"
          class="neo-button w-full text-center block bg-[#A7F3D0] hover:bg-[#6EE7B7] text-black px-4 py-3 text-sm font-black"
          aria-label={`Join ${community.title} on ${platformName} (opens in a new tab)`}
        >
          Open in {platformName} &rarr;
        </a>

        <div class="text-[11px] text-black/70 font-medium text-center">
          Invite URL: <span class="font-mono break-all">{community.inviteUrl}</span>
        </div>
      </div>

      <!-- Quick Facts Box -->
      <div class="neo-card p-5 bg-white text-xs font-bold text-black space-y-2.5">
        <h4 class="font-black uppercase tracking-wider text-black text-xs pb-2 border-b-2 border-black/10">
          Listing Facts
        </h4>
        <div class="flex justify-between">
          <span class="text-slate-600">Platform:</span>
          <span>{platformName}</span>
        </div>
        <div class="flex justify-between">
          <span class="text-slate-600">Primary Country:</span>
          <span>{countryName}</span>
        </div>
        <div class="flex justify-between">
          <span class="text-slate-600">Category:</span>
          <span>{categoryName}</span>
        </div>
        {community.city && (
          <div class="flex justify-between">
            <span class="text-slate-600">Location:</span>
            <span>{community.city}</span>
          </div>
        )}
        {typeof community.memberCount === "number" && (
          <div class="flex justify-between">
            <span class="text-slate-600">Observed Members:</span>
            <span>{community.memberCount.toLocaleString()}</span>
          </div>
        )}
      </div>

      <div class="text-center">
        <a href="/report/" class="text-xs font-bold text-slate-600 hover:text-black underline">
          Report broken link or spam
        </a>
      </div>
    </div>
  </div>

  <SafetyNotice type="job-warning" />
</DirectoryLayout>

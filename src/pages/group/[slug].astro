---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PlatformBadge from "../../components/PlatformBadge.astro";
import CategoryBadge from "../../components/CategoryBadge.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import VerificationBadge from "../../components/VerificationBadge.astro";
import SafetyNotice from "../../components/SafetyNotice.astro";
import CommunityGrid from "../../components/CommunityGrid.astro";
import { getPublishedCommunities, getRelatedCommunities } from "../../lib/communities";
import { getCategoryBySlug } from "../../config/categories";
import { getPlatformById } from "../../config/platforms";
import { formatDate } from "../../lib/dates";
import { generateCommunityDetailSchema } from "../../lib/schema";
import type { Community } from "../../types/community";

export async function getStaticPaths() {
  const communities = getPublishedCommunities();
  return communities.map((comm) => ({
    params: { slug: comm.slug },
    props: { community: comm },
  }));
}

interface Props {
  community: Community;
}

const { community } = Astro.props;
const categoryConfig = getCategoryBySlug(community.category);
const platformConfig = getPlatformById(community.platform);
const relatedCommunities = getRelatedCommunities(community, 3);
const schema = generateCommunityDetailSchema(community);

const breadcrumbs = [
  { name: "Browse", item: "/communities" },
  { name: categoryConfig?.name || community.category, item: `/category/${community.category}` },
  { name: community.title, item: `/group/${community.slug}` },
];
---

<BaseLayout
  title={`${community.title} — ${platformConfig?.name || community.platform}`}
  description={community.description || `Discover ${community.title} on ${community.platform}. Public online community in ${community.category}.`}
  canonicalPath={`/group/${community.slug}`}
  jsonLd={schema}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Main Listing Header Card -->
    <div class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm mb-8">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
        <div class="flex flex-wrap items-center gap-2">
          <PlatformBadge platform={community.platform} size="md" showLink={true} />
          <CategoryBadge category={community.category} size="md" showLink={true} />
          {community.subcategory && (
            <span class="rounded-md bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600">
              {community.subcategory}
            </span>
          )}
        </div>
        <div class="flex items-center gap-2">
          <StatusBadge status={community.linkStatus} size="md" />
          <VerificationBadge status={community.verificationStatus} size="md" />
        </div>
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">
        {community.title}
      </h1>

      <p class="text-sm sm:text-base text-slate-700 leading-relaxed mb-6">
        {community.description || `A public ${community.platform} community listed under ${categoryConfig?.name || community.category}.`}
      </p>

      <!-- Tags -->
      {community.tags && community.tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mb-6">
          {community.tags.map((tag) => (
            <a
              href={`/tag/${tag.toLowerCase()}`}
              class="rounded-lg bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600 hover:bg-slate-200 transition-colors"
            >
              #{tag}
            </a>
          ))}
        </div>
      )}

      <!-- CTAs Row -->
      <div class="flex flex-wrap items-center gap-3 pt-6 border-t border-slate-100">
        <a
          href={community.inviteUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-600 px-6 py-3 text-sm font-bold text-white shadow hover:bg-emerald-700 transition-all"
        >
          <span>Visit & Join Community</span>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>

        <a
          href={`/report?id=${encodeURIComponent(community.id)}&title=${encodeURIComponent(community.title)}&url=${encodeURIComponent(community.inviteUrl)}`}
          class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-slate-200 bg-white px-4 py-3 text-xs font-semibold text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-colors"
        >
          <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <span>Report Problem / Broken Link</span>
        </a>
      </div>
    </div>

    <!-- Structured Factual Metadata Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
      <!-- Community Details Box -->
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900 mb-4 pb-2 border-b border-slate-100">
          Community Information
        </h2>
        <dl class="divide-y divide-slate-100 text-xs sm:text-sm">
          <div class="py-2.5 flex justify-between">
            <dt class="text-slate-500 font-medium">Platform</dt>
            <dd class="text-slate-900 font-semibold capitalize">{community.platform}</dd>
          </div>
          <div class="py-2.5 flex justify-between">
            <dt class="text-slate-500 font-medium">Category</dt>
            <dd class="text-slate-900 font-semibold">{categoryConfig?.name || community.category}</dd>
          </div>
          <div class="py-2.5 flex justify-between">
            <dt class="text-slate-500 font-medium">Access Type</dt>
            <dd class="text-slate-900 font-semibold capitalize">{community.accessType || "Free"}</dd>
          </div>
          <div class="py-2.5 flex justify-between">
            <dt class="text-slate-500 font-medium">Primary Language</dt>
            <dd class="text-slate-900 font-semibold uppercase">{community.language || "Not specified"}</dd>
          </div>
          {community.country && (
            <div class="py-2.5 flex justify-between">
              <dt class="text-slate-500 font-medium">Target Country</dt>
              <dd class="text-slate-900 font-semibold uppercase">{community.country}</dd>
            </div>
          )}
          {typeof community.memberCount === "number" && (
            <div class="py-2.5 flex justify-between">
              <dt class="text-slate-500 font-medium">Sourced Members</dt>
              <dd class="text-slate-900 font-semibold">{community.memberCount.toLocaleString()}</dd>
            </div>
          )}
        </dl>
      </div>

      <!-- Verification & Health Audit Box -->
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-sm font-bold uppercase tracking-wider text-slate-900 mb-4 pb-2 border-b border-slate-100">
          Verification & Health Audit
        </h2>
        <dl class="divide-y divide-slate-100 text-xs sm:text-sm">
          <div class="py-2.5 flex justify-between">
            <dt class="text-slate-500 font-medium">Verification Tier</dt>
            <dd class="text-slate-900 font-semibold capitalize">{community.verificationStatus.replace("-", " ")}</dd>
          </div>
          <div class="py-2.5 flex justify-between">
            <dt class="text-slate-500 font-medium">Link Health</dt>
            <dd class="text-slate-900 font-semibold capitalize">{community.linkStatus}</dd>
          </div>
          <div class="py-2.5 flex justify-between">
            <dt class="text-slate-500 font-medium">Discovered Date</dt>
            <dd class="text-slate-900 font-semibold">{formatDate(community.discoveredAt)}</dd>
          </div>
          <div class="py-2.5 flex justify-between">
            <dt class="text-slate-500 font-medium">Last Link Check</dt>
            <dd class="text-slate-900 font-semibold">{formatDate(community.lastCheckedAt)}</dd>
          </div>
          <div class="py-2.5 flex justify-between">
            <dt class="text-slate-500 font-medium">Discovery Method</dt>
            <dd class="text-slate-900 font-semibold capitalize">{community.discoveryMethod.replace("-", " ")}</dd>
          </div>
        </dl>
      </div>
    </div>

    <!-- Source Information (If available) -->
    {community.sourceUrls && community.sourceUrls.length > 0 && (
      <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-5 mb-8 text-xs text-slate-600">
        <strong class="font-semibold text-slate-900 block mb-1">Source & Evidence Attribution</strong>
        <p class="mb-2 text-slate-500">
          This community listing was identified and confirmed from the following public source:
        </p>
        <ul class="space-y-1 font-mono text-[11px] break-all">
          {community.sourceUrls.map((url) => (
            <li class="text-slate-700">• {url}</li>
          ))}
        </ul>
      </div>
    )}

    <!-- Safety & Category Notices -->
    <div class="mb-12 space-y-4">
      {categoryConfig?.financialDisclaimerRequired && (
        <SafetyNotice type="financial" />
      )}
      <SafetyNotice type="general" />
    </div>

    <!-- Related Communities -->
    {relatedCommunities.length > 0 && (
      <div>
        <h2 class="text-xl font-bold text-slate-900 mb-4">Related Communities</h2>
        <CommunityGrid communities={relatedCommunities} />
      </div>
    )}
  </div>
</BaseLayout>

---
import { siteConfig } from "../config/site";
import { getDatasetStats } from "../lib/communities";

const stats = getDatasetStats();
---

<footer class="mt-auto border-t-[3px] border-black bg-white text-black">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 md:grid-cols-4 lg:grid-cols-5">
      <!-- Brand & Mission Column -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-2.5">
          <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-[#FEF08A] text-black border-2 border-black shadow-[2px_2px_0px_0px_#000]">
            <svg class="h-5 w-5 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <span class="text-base font-black text-black">{siteConfig.name}</span>
        </a>
        <p class="text-xs font-medium leading-relaxed text-slate-700 max-w-sm">
          Discover public Discord servers, Telegram channels, and WhatsApp groups sharing job openings, hiring alerts, career opportunities, and remote work across the USA, UK, Canada, and Australia.
        </p>

        <div class="rounded-xl border-2 border-black bg-[#FEF9C3] p-3.5 text-xs text-black font-bold space-y-1.5 shadow-[2px_2px_0px_0px_#000]">
          <div class="flex items-center justify-between">
            <span>Active Job Communities:</span>
            <strong class="text-black font-black text-sm">{stats.totalPublished}</strong>
          </div>
          <div class="flex items-center justify-between">
            <span>Target Markets:</span>
            <span class="text-black font-black">USA, UK, Canada, Australia</span>
          </div>
          <div class="flex items-center justify-between">
            <span>Platforms:</span>
            <span class="text-black font-black">Discord, Telegram, WhatsApp</span>
          </div>
        </div>
      </div>

      <!-- Countries Column -->
      <div>
        <h3 class="text-xs font-black uppercase tracking-wider text-black bg-[#BAE6FD] px-2 py-0.5 rounded border border-black shadow-[1px_1px_0px_0px_#000] inline-block mb-3">
          Target Countries
        </h3>
        <ul class="space-y-2 text-xs font-bold">
          {siteConfig.footerNav.countries.map((item) => (
            <li>
              <a href={item.href} class="hover:underline text-black">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Job Types Column -->
      <div>
        <h3 class="text-xs font-black uppercase tracking-wider text-black bg-[#FEF08A] px-2 py-0.5 rounded border border-black shadow-[1px_1px_0px_0px_#000] inline-block mb-3">
          Job Categories
        </h3>
        <ul class="space-y-2 text-xs font-bold">
          {siteConfig.footerNav.jobTypes.map((item) => (
            <li>
              <a href={item.href} class="hover:underline text-black">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Trust & Legal Column -->
      <div>
        <h3 class="text-xs font-black uppercase tracking-wider text-black bg-[#A7F3D0] px-2 py-0.5 rounded border border-black shadow-[1px_1px_0px_0px_#000] inline-block mb-3">
          Trust & Safety
        </h3>
        <ul class="space-y-2 text-xs font-bold">
          {siteConfig.footerNav.trustAndLegal.map((item) => (
            <li>
              <a href={item.href} class="hover:underline text-black">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Disclaimer & Copyright Bar -->
    <div class="mt-12 pt-6 border-t-2 border-black flex flex-col md:flex-row items-center justify-between gap-4 text-xs font-bold text-slate-700">
      <div>
        &copy; {new Date().getFullYear()} {siteConfig.name}. An independent public job alert community directory.
      </div>
      <div class="flex items-center gap-4">
        <a href="/disclaimer/" class="hover:underline text-black">Disclaimer</a>
        <span>&bull;</span>
        <a href="/privacy/" class="hover:underline text-black">Privacy</a>
        <span>&bull;</span>
        <a href="/terms/" class="hover:underline text-black">Terms</a>
        <span>&bull;</span>
        <a href="/report/" class="hover:underline text-black">Report</a>
      </div>
    </div>
  </div>
</footer>

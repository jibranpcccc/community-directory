---
interface Props {
  placeholder?: string;
  size?: "sm" | "md" | "lg";
  actionUrl?: string;
}

const {
  placeholder = "Search job communities (e.g. Remote, Tech, Internships)...",
  size = "md",
  actionUrl = "/jobs",
} = Astro.props;

const sizeClasses = {
  sm: "py-2 px-3 text-xs",
  md: "py-3 px-4 text-sm",
  lg: "py-4 px-5 text-base font-bold",
};
---

<form
  action={actionUrl}
  method="GET"
  class="relative flex w-full items-center"
  role="search"
  aria-label="Job community search"
>
  <label for="search-input" class="sr-only">Search job communities</label>
  <div class="relative w-full">
    <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4">
      <svg
        class="h-5 w-5 text-black"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2.5"
          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
        />
      </svg>
    </div>

    <input
      id="search-input"
      type="search"
      name="search"
      placeholder={placeholder}
      class={`w-full rounded-2xl border-[3px] border-black bg-white pl-11 pr-24 font-bold text-black placeholder-slate-500 shadow-[3px_3px_0px_0px_#000] focus:bg-[#FEF9C3] focus:outline-none focus:ring-2 focus:ring-black ${sizeClasses[size]}`}
    />

    <div class="absolute inset-y-0 right-1.5 flex items-center">
      <button
        type="submit"
        class="neo-btn rounded-xl border-2 border-black bg-[#FEF08A] hover:bg-[#FDE047] px-3.5 py-1.5 text-xs font-black text-black shadow-[2px_2px_0px_0px_#000]"
        aria-label="Execute search"
      >
        Search
      </button>
    </div>
  </div>
</form>

---
interface Props {
  placeholder?: string;
  actionUrl?: string;
  initialValue?: string;
  size?: "md" | "lg";
}

const {
  placeholder = "Search communities by title, keyword, tech, or topic...",
  actionUrl = "/communities",
  initialValue = "",
  size = "lg",
} = Astro.props;

const heightClass = size === "lg" ? "py-3.5 pl-11 pr-28 text-sm sm:text-base" : "py-2.5 pl-10 pr-20 text-sm";
const iconSize = size === "lg" ? "h-5 w-5 left-3.5" : "h-4 w-4 left-3";
---

<form action={actionUrl} method="GET" class="relative w-full max-w-2xl mx-auto">
  <div class="relative flex items-center">
    <svg
      class={`absolute ${iconSize} text-slate-400 pointer-events-none`}
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
      />
    </svg>
    <input
      type="search"
      name="search"
      id="search-input"
      value={initialValue}
      placeholder={placeholder}
      class={`w-full rounded-2xl border border-slate-200 bg-white shadow-sm placeholder:text-slate-400 focus:border-emerald-500 focus:outline-none focus:ring-4 focus:ring-emerald-500/10 transition-all ${heightClass}`}
      autocomplete="off"
    />
    <button
      type="submit"
      class="absolute right-2 rounded-xl bg-slate-900 px-4 py-2 text-xs font-semibold text-white shadow-sm hover:bg-slate-800 transition-colors"
    >
      Search
    </button>
  </div>
</form>

---
import { categories } from "../config/categories";
import { platforms } from "../config/platforms";
import type { FilterOptions, SortOption } from "../types/community";

interface Props {
  currentFilters?: FilterOptions;
  currentSort?: SortOption;
  totalCount?: number;
}

const {
  currentFilters = {},
  currentSort = "newest",
  totalCount = 0,
} = Astro.props;

const activePlatforms = platforms.filter((p) => p.isConfigured);
---

<div class="neo-card p-5 sm:p-6 mb-8 bg-white">
  <form id="directory-filter-form" method="GET" class="space-y-4">
    <!-- Top Row: Search Input -->
    <div class="relative">
      <svg
        class="absolute left-3.5 top-3.5 h-4 w-4 text-black pointer-events-none"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2.5"
          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
        />
      </svg>
      <input
        type="search"
        name="search"
        id="filter-search-input"
        value={currentFilters.search || ""}
        placeholder="Filter by keyword, topic, language, or title..."
        class="w-full rounded-xl border-2 border-black py-2.5 pl-10 pr-4 text-sm font-medium text-black placeholder:text-slate-500 shadow-[2px_2px_0px_0px_#000] focus:outline-none focus:shadow-[4px_4px_0px_0px_#000]"
      />
    </div>

    <!-- Filter Dropdowns Grid -->
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Category -->
      <div>
        <label for="filter-category" class="block text-xs font-black uppercase tracking-wider text-black mb-1">
          Category
        </label>
        <select
          name="category"
          id="filter-category"
          class="w-full rounded-xl border-2 border-black bg-[#FAF8F5] py-2 px-3 text-xs font-bold text-black shadow-[2px_2px_0px_0px_#000] focus:bg-white focus:outline-none"
        >
          <option value="">All Categories</option>
          {categories.map((c) => (
            <option value={c.slug} selected={currentFilters.category === c.slug}>
              {c.name}
            </option>
          ))}
        </select>
      </div>

      <!-- Platform -->
      <div>
        <label for="filter-platform" class="block text-xs font-black uppercase tracking-wider text-black mb-1">
          Platform
        </label>
        <select
          name="platform"
          id="filter-platform"
          class="w-full rounded-xl border-2 border-black bg-[#FAF8F5] py-2 px-3 text-xs font-bold text-black shadow-[2px_2px_0px_0px_#000] focus:bg-white focus:outline-none"
        >
          <option value="">All Platforms</option>
          {activePlatforms.map((p) => (
            <option value={p.id} selected={currentFilters.platform === p.id}>
              {p.name}
            </option>
          ))}
        </select>
      </div>

      <!-- Verification Tier -->
      <div>
        <label for="filter-verification" class="block text-xs font-black uppercase tracking-wider text-black mb-1">
          Verification Tier
        </label>
        <select
          name="verificationStatus"
          id="filter-verification"
          class="w-full rounded-xl border-2 border-black bg-[#FAF8F5] py-2 px-3 text-xs font-bold text-black shadow-[2px_2px_0px_0px_#000] focus:bg-white focus:outline-none"
        >
          <option value="">Any Verification</option>
          <option value="source-confirmed" selected={currentFilters.verificationStatus === "source-confirmed"}>
            Source Confirmed
          </option>
          <option value="manually-reviewed" selected={currentFilters.verificationStatus === "manually-reviewed"}>
            Manually Reviewed
          </option>
          <option value="owner-confirmed" selected={currentFilters.verificationStatus === "owner-confirmed"}>
            Owner Confirmed
          </option>
          <option value="unverified" selected={currentFilters.verificationStatus === "unverified"}>
            Unverified
          </option>
        </select>
      </div>

      <!-- Sort -->
      <div>
        <label for="filter-sort" class="block text-xs font-black uppercase tracking-wider text-black mb-1">
          Sort By
        </label>
        <select
          name="sort"
          id="filter-sort"
          class="w-full rounded-xl border-2 border-black bg-[#FAF8F5] py-2 px-3 text-xs font-bold text-black shadow-[2px_2px_0px_0px_#000] focus:bg-white focus:outline-none"
        >
          <option value="newest" selected={currentSort === "newest"}>Newest Added</option>
          <option value="recently-checked" selected={currentSort === "recently-checked"}>Recently Checked</option>
          <option value="alphabetical" selected={currentSort === "alphabetical"}>Alphabetical (A–Z)</option>
          <option value="member-count" selected={currentSort === "member-count"}>Member Count (Sourced)</option>
        </select>
      </div>
    </div>

    <!-- Active Filters & Reset Bar -->
    <div class="flex flex-wrap items-center justify-between gap-3 pt-3.5 border-t-2 border-black/10 text-xs font-bold text-black">
      <div>
        Showing <strong class="font-black underline">{totalCount}</strong> matching listings
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/communities"
          class="text-xs font-black text-black hover:underline"
        >
          Reset filters
        </a>
        <button
          type="submit"
          class="neo-button bg-[#A7F3D0] hover:bg-[#6EE7B7] px-4 py-2 text-xs font-black text-black"
        >
          Apply Filters
        </button>
      </div>
    </div>
  </form>
</div>

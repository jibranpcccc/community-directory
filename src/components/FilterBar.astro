---
import { categories } from "../config/categories";
import { platforms } from "../config/platforms";
import type { FilterOptions, SortOption } from "../types/community";

interface Props {
  currentFilters?: FilterOptions;
  currentSort?: SortOption;
  totalCount?: number;
}

const {
  currentFilters = {},
  currentSort = "newest",
  totalCount = 0,
} = Astro.props;

const activePlatforms = platforms.filter((p) => p.isConfigured);
---

<div class="rounded-2xl border border-slate-200 bg-white p-4 sm:p-5 shadow-sm mb-8">
  <form id="directory-filter-form" method="GET" class="space-y-4">
    <!-- Top Row: Search Input -->
    <div class="relative">
      <svg
        class="absolute left-3.5 top-3.5 h-4 w-4 text-slate-400 pointer-events-none"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
        />
      </svg>
      <input
        type="search"
        name="search"
        id="filter-search-input"
        value={currentFilters.search || ""}
        placeholder="Filter by keyword, topic, language, or title..."
        class="w-full rounded-xl border border-slate-200 py-2.5 pl-10 pr-4 text-sm placeholder:text-slate-400 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/20"
      />
    </div>

    <!-- Filter Dropdowns Grid -->
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Category -->
      <div>
        <label for="filter-category" class="block text-xs font-semibold text-slate-600 mb-1">
          Category
        </label>
        <select
          name="category"
          id="filter-category"
          class="w-full rounded-lg border border-slate-200 bg-slate-50/50 py-2 px-3 text-xs font-medium text-slate-700 focus:border-emerald-500 focus:bg-white focus:outline-none"
        >
          <option value="">All Categories</option>
          {categories.map((c) => (
            <option value={c.slug} selected={currentFilters.category === c.slug}>
              {c.name}
            </option>
          ))}
        </select>
      </div>

      <!-- Platform -->
      <div>
        <label for="filter-platform" class="block text-xs font-semibold text-slate-600 mb-1">
          Platform
        </label>
        <select
          name="platform"
          id="filter-platform"
          class="w-full rounded-lg border border-slate-200 bg-slate-50/50 py-2 px-3 text-xs font-medium text-slate-700 focus:border-emerald-500 focus:bg-white focus:outline-none"
        >
          <option value="">All Platforms</option>
          {activePlatforms.map((p) => (
            <option value={p.id} selected={currentFilters.platform === p.id}>
              {p.name}
            </option>
          ))}
        </select>
      </div>

      <!-- Verification Tier -->
      <div>
        <label for="filter-verification" class="block text-xs font-semibold text-slate-600 mb-1">
          Verification Tier
        </label>
        <select
          name="verificationStatus"
          id="filter-verification"
          class="w-full rounded-lg border border-slate-200 bg-slate-50/50 py-2 px-3 text-xs font-medium text-slate-700 focus:border-emerald-500 focus:bg-white focus:outline-none"
        >
          <option value="">Any Verification</option>
          <option value="source-confirmed" selected={currentFilters.verificationStatus === "source-confirmed"}>
            Source Confirmed
          </option>
          <option value="manually-reviewed" selected={currentFilters.verificationStatus === "manually-reviewed"}>
            Manually Reviewed
          </option>
          <option value="owner-confirmed" selected={currentFilters.verificationStatus === "owner-confirmed"}>
            Owner Confirmed
          </option>
          <option value="unverified" selected={currentFilters.verificationStatus === "unverified"}>
            Unverified
          </option>
        </select>
      </div>

      <!-- Sort -->
      <div>
        <label for="filter-sort" class="block text-xs font-semibold text-slate-600 mb-1">
          Sort By
        </label>
        <select
          name="sort"
          id="filter-sort"
          class="w-full rounded-lg border border-slate-200 bg-slate-50/50 py-2 px-3 text-xs font-medium text-slate-700 focus:border-emerald-500 focus:bg-white focus:outline-none"
        >
          <option value="newest" selected={currentSort === "newest"}>Newest Added</option>
          <option value="recently-checked" selected={currentSort === "recently-checked"}>Recently Checked</option>
          <option value="alphabetical" selected={currentSort === "alphabetical"}>Alphabetical (A–Z)</option>
          <option value="member-count" selected={currentSort === "member-count"}>Member Count (Sourced)</option>
        </select>
      </div>
    </div>

    <!-- Active Filters & Reset Bar -->
    <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-slate-100 text-xs text-slate-500">
      <div>
        Showing <strong class="font-semibold text-slate-800">{totalCount}</strong> matching listings
      </div>

      <div class="flex items-center gap-2">
        <a
          href="/communities"
          class="inline-flex items-center text-xs text-slate-500 hover:text-slate-800 transition-colors"
        >
          Reset filters
        </a>
        <button
          type="submit"
          class="rounded-lg bg-emerald-600 px-4 py-1.5 font-semibold text-white hover:bg-emerald-700 transition-colors"
        >
          Apply Filters
        </button>
      </div>
    </div>
  </form>
</div>

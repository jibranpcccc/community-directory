---
import { siteConfig } from "../config/site";
---

<header class="sticky top-0 z-40 w-full border-b-[3px] border-black bg-white">
  <div class="max-w-7xl mx-auto flex h-18 items-center justify-between px-4 sm:px-6 lg:px-8 py-3">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#FEF08A] text-black border-2 border-black shadow-[3px_3px_0px_0px_#000] transition-transform group-hover:scale-105 group-hover:rotate-1">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="text-lg font-black tracking-tight text-black leading-none">
          {siteConfig.shortName}
        </span>
        <span class="text-[10px] font-black uppercase tracking-wider text-black bg-[#A7F3D0] px-1.5 py-0.5 rounded border border-black mt-1 shadow-[1.5px_1.5px_0px_0px_#000] inline-block w-fit">
          Public Directory
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-4 text-xs font-black text-black">
      <a href="/communities" class="rounded-lg px-3 py-1.5 hover:bg-[#FEF08A] hover:border-2 hover:border-black transition-all">Browse</a>
      <a href="/platform/discord" class="rounded-lg px-3 py-1.5 hover:bg-[#DDD6FE] hover:border-2 hover:border-black transition-all">Discord</a>
      <a href="/platform/telegram" class="rounded-lg px-3 py-1.5 hover:bg-[#BAE6FD] hover:border-2 hover:border-black transition-all">Telegram</a>
      <a href="/platform/whatsapp" class="rounded-lg px-3 py-1.5 hover:bg-[#A7F3D0] hover:border-2 hover:border-black transition-all">WhatsApp</a>
      <a href="/new" class="rounded-lg px-3 py-1.5 hover:bg-[#FED7AA] hover:border-2 hover:border-black transition-all">New</a>
      <a href="/safety" class="rounded-lg px-3 py-1.5 hover:bg-[#FECDD3] hover:border-2 hover:border-black transition-all">Safety</a>
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-3">
      <a
        href="/submit"
        class="neo-button bg-[#A7F3D0] hover:bg-[#6EE7B7] text-black px-4 py-2 text-xs font-black"
      >
        <svg class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
        </svg>
        <span>+ Submit Listing</span>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-button"
        type="button"
        class="inline-flex items-center justify-center rounded-xl p-2 bg-white text-black border-2 border-black shadow-[2px_2px_0px_0px_#000] md:hidden"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-menu" class="hidden md:hidden border-t-2 border-black bg-[#FAF8F5] px-4 pt-3 pb-5 space-y-2" aria-label="Mobile navigation">
    <a href="/communities" class="block rounded-xl border-2 border-black bg-white px-3 py-2 text-sm font-black text-black shadow-[2px_2px_0px_0px_#000]">
      Browse All Communities
    </a>
    <a href="/platform/discord" class="block rounded-xl border-2 border-black bg-[#DDD6FE] px-3 py-2 text-sm font-black text-black shadow-[2px_2px_0px_0px_#000]">
      Discord Servers
    </a>
    <a href="/platform/telegram" class="block rounded-xl border-2 border-black bg-[#BAE6FD] px-3 py-2 text-sm font-black text-black shadow-[2px_2px_0px_0px_#000]">
      Telegram Channels & Groups
    </a>
    <a href="/platform/whatsapp" class="block rounded-xl border-2 border-black bg-[#A7F3D0] px-3 py-2 text-sm font-black text-black shadow-[2px_2px_0px_0px_#000]">
      WhatsApp Communities
    </a>
    <a href="/new" class="block rounded-xl border-2 border-black bg-[#FED7AA] px-3 py-2 text-sm font-black text-black shadow-[2px_2px_0px_0px_#000]">
      Recently Added
    </a>
    <a href="/recently-updated" class="block rounded-xl border-2 border-black bg-[#FEF08A] px-3 py-2 text-sm font-black text-black shadow-[2px_2px_0px_0px_#000]">
      Recently Checked
    </a>
    <a href="/safety" class="block rounded-xl border-2 border-black bg-[#FECDD3] px-3 py-2 text-sm font-black text-black shadow-[2px_2px_0px_0px_#000]">
      Safety & Verification
    </a>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-button");
  const menu = document.getElementById("mobile-menu");
  if (btn && menu) {
    btn.addEventListener("click", () => {
      const isHidden = menu.classList.toggle("hidden");
      btn.setAttribute("aria-expanded", isHidden ? "false" : "true");
    });
  }
</script>

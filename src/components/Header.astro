---
import { siteConfig } from "../config/site";
import { ENABLED_COUNTRIES } from "../config/countries";
---

<header class="sticky top-0 z-40 w-full border-b-[3px] border-black bg-white">
  <div class="max-w-7xl mx-auto flex h-18 items-center justify-between px-4 sm:px-6 lg:px-8 py-3">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group" aria-label="JobAlertHub Homepage">
      <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#FEF08A] text-black border-2 border-black shadow-[3px_3px_0px_0px_#000] transition-transform group-hover:scale-105">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="text-base sm:text-lg font-black tracking-tight text-black leading-none">
          {siteConfig.name}
        </span>
        <span class="text-[9px] sm:text-[10px] font-black uppercase tracking-wider text-black bg-[#A7F3D0] px-1.5 py-0.5 rounded border border-black mt-1 shadow-[1px_1px_0px_0px_#000] inline-block w-fit">
          Job Alert Groups
        </span>
      </div>
    </a>

    <!-- Desktop Navigation (lg:flex to avoid tablet 768px horizontal collisions) -->
    <nav class="hidden lg:flex items-center gap-1.5 xl:gap-2 text-xs font-black text-black" aria-label="Main Navigation">
      <a href="/jobs/" class="rounded-lg px-2.5 py-1.5 hover:bg-[#FEF08A] hover:border-2 hover:border-black transition-all">All Jobs</a>
      <a href="/country/global/" class="rounded-lg px-2.5 py-1.5 hover:bg-[#A7F3D0] hover:border-2 hover:border-black transition-all">Worldwide/Remote</a>
      <a href="/job-type/remote-jobs/" class="rounded-lg px-2.5 py-1.5 hover:bg-[#BAE6FD] hover:border-2 hover:border-black transition-all">Remote</a>
      <a href="/category/tech-jobs/" class="rounded-lg px-2.5 py-1.5 hover:bg-[#FEF9C3] hover:border-2 hover:border-black transition-all">Tech</a>

      <!-- Markets Dropdown -->
      <div class="relative group">
        <button
          type="button"
          class="inline-flex items-center gap-1 rounded-lg px-2.5 py-1.5 hover:bg-[#FED7AA] hover:border-2 hover:border-black transition-all"
          aria-expanded="false"
        >
          <span>Markets (14)</span>
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div class="absolute left-0 top-full hidden group-hover:block group-focus-within:block w-72 pt-2 z-50">
          <div class="rounded-2xl border-[3px] border-black bg-white p-3 shadow-[4px_4px_0px_0px_#000] grid grid-cols-2 gap-1 text-xs">
            {ENABLED_COUNTRIES.map((c) => (
              <a
                href={`/country/${c.slug}/`}
                class="flex items-center gap-1.5 p-1.5 rounded-lg hover:bg-[#FAF8F5] font-bold text-slate-800 hover:text-black"
              >
                <span class="px-1 py-0.5 text-[9px] font-black bg-slate-100 border border-black rounded shadow-[0.5px_0.5px_0px_0px_#000]">{c.code}</span>
                <span class="truncate">{c.shortName}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <a href="/how-we-verify/" class="rounded-lg px-2.5 py-1.5 hover:bg-[#A7F3D0] hover:border-2 hover:border-black transition-all">How We Verify</a>
      <a href="/safety/" class="rounded-lg px-2.5 py-1.5 hover:bg-[#FDE047] hover:border-2 hover:border-black transition-all">Safety</a>
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-2 sm:gap-3">
      <a
        href="/submit/"
        class="neo-btn inline-flex items-center bg-[#A7F3D0] hover:bg-[#6EE7B7] text-black px-3 sm:px-4 py-2 text-xs font-black border-2 border-black shadow-[2px_2px_0px_0px_#000]"
      >
        <svg class="h-3.5 w-3.5 sm:mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
        </svg>
        <span class="hidden sm:inline">Submit Group</span>
        <span class="sm:hidden">Submit</span>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-button"
        type="button"
        class="inline-flex items-center justify-center rounded-xl p-2 bg-white text-black border-2 border-black shadow-[2px_2px_0px_0px_#000] lg:hidden"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer with All 14 Markets Grid -->
  <div id="mobile-menu" class="hidden lg:hidden border-t-2 border-black bg-[#FAF8F5] px-4 pt-3 pb-6 space-y-4" aria-label="Mobile navigation">
    <div class="grid grid-cols-2 gap-2">
      <a href="/jobs/" class="rounded-xl border-2 border-black bg-white px-3 py-2 text-xs font-black text-black shadow-[2px_2px_0px_0px_#000]">
        All Job Groups
      </a>
      <a href="/country/global/" class="rounded-xl border-2 border-black bg-[#A7F3D0] px-3 py-2 text-xs font-black text-black shadow-[2px_2px_0px_0px_#000]">
        Worldwide/Remote
      </a>
      <a href="/job-type/remote-jobs/" class="rounded-xl border-2 border-black bg-[#BAE6FD] px-3 py-2 text-xs font-black text-black shadow-[2px_2px_0px_0px_#000]">
        Remote Jobs
      </a>
      <a href="/category/tech-jobs/" class="rounded-xl border-2 border-black bg-[#FEF9C3] px-3 py-2 text-xs font-black text-black shadow-[2px_2px_0px_0px_#000]">
        Tech Jobs
      </a>
      <a href="/how-we-verify/" class="rounded-xl border-2 border-black bg-white px-3 py-2 text-xs font-black text-black shadow-[2px_2px_0px_0px_#000]">
        How We Verify
      </a>
      <a href="/safety/" class="rounded-xl border-2 border-black bg-[#FEF08A] px-3 py-2 text-xs font-black text-black shadow-[2px_2px_0px_0px_#000]">
        Safety Guide
      </a>
    </div>

    <!-- Target Markets 2-Column Grid -->
    <div class="space-y-2 pt-2 border-t border-black/10">
      <div class="text-[11px] font-black uppercase tracking-wider text-black">
        Browse 14 Target Markets (13 Countries + Worldwide/Remote)
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-1.5">
        {ENABLED_COUNTRIES.map((c) => (
          <a
            href={`/country/${c.slug}/`}
            class="flex items-center gap-1.5 rounded-lg border border-black bg-white p-2 text-xs font-bold text-black shadow-[1px_1px_0px_0px_#000] hover:bg-[#FEF08A]"
          >
            <span class="px-1 py-0.5 text-[9px] font-black bg-slate-100 border border-black rounded">{c.code}</span>
            <span class="truncate">{c.name}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<script is:inline>
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
    });
  }
</script>

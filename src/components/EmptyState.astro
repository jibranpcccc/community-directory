---
interface Props {
  title?: string;
  message?: string;
  showReset?: boolean;
}

const {
  title = "No job communities found",
  message = "Try clearing or adjusting your search filters to find more communities.",
  showReset = true,
} = Astro.props;
---

<div class="neo-card flex flex-col items-center justify-center p-8 sm:p-12 text-center bg-white my-6">
  <div class="flex h-16 w-16 items-center justify-center rounded-2xl border-[3px] border-black bg-[#FEF08A] text-black shadow-[3px_3px_0px_0px_#000] mb-4">
    <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
  </div>

  <h3 class="text-lg sm:text-xl font-black text-black mb-2">
    {title}
  </h3>

  <p class="max-w-md text-xs sm:text-sm font-bold text-slate-700 mb-6 leading-relaxed">
    {message}
  </p>

  {showReset && (
    <a
      href="/jobs"
      class="neo-btn inline-flex items-center gap-2 bg-[#FEF08A] hover:bg-[#FDE047] text-black font-black px-5 py-2.5 text-xs border-2 border-black shadow-[3px_3px_0px_0px_#000]"
    >
      <span>Browse All Job Groups &rarr;</span>
    </a>
  )}
</div>

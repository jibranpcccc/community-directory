---
import type { BreadcrumbItem } from "../lib/schema";

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
const allItems = [{ name: "Home", item: "/" }, ...items];
---

<nav aria-label="Breadcrumb" class="mb-4">
  <ol class="flex flex-wrap items-center gap-2 text-xs font-bold text-slate-700">
    {
      allItems.map((crumb, index) => {
        const isLast = index === allItems.length - 1;
        return (
          <li class="flex items-center gap-2">
            {index > 0 && (
              <span class="text-black font-black">/</span>
            )}
            {isLast ? (
              <span class="rounded bg-white px-2 py-0.5 border border-black text-black font-black shadow-[1px_1px_0px_0px_#000]" aria-current="page">
                {crumb.name}
              </span>
            ) : (
              <a
                href={crumb.item}
                class="hover:underline text-black"
              >
                {crumb.name}
              </a>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>

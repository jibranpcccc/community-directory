---
import type { LinkStatus } from "../types/community";

interface Props {
  status: LinkStatus;
  size?: "sm" | "md";
}

const { status, size = "md" } = Astro.props;

const config: Record<LinkStatus, { label: string; class: string; dot: string }> = {
  active: {
    label: "Active Link",
    class: "bg-[#A7F3D0] text-black border-2 border-black shadow-[1.5px_1.5px_0px_0px_#000]",
    dot: "bg-black",
  },
  unknown: {
    label: "Unchecked",
    class: "bg-[#FEF08A] text-black border-2 border-black shadow-[1.5px_1.5px_0px_0px_#000]",
    dot: "bg-black",
  },
  dead: {
    label: "Link Dead",
    class: "bg-[#FECDD3] text-black border-2 border-black shadow-[1.5px_1.5px_0px_0px_#000]",
    dot: "bg-black",
  },
  removed: {
    label: "Removed",
    class: "bg-slate-200 text-black border-2 border-black shadow-[1.5px_1.5px_0px_0px_#000]",
    dot: "bg-black",
  },
  reported: {
    label: "Reported",
    class: "bg-[#DDD6FE] text-black border-2 border-black shadow-[1.5px_1.5px_0px_0px_#000]",
    dot: "bg-black",
  },
};

const current = config[status] || config.unknown;
const sizeClass = size === "sm" ? "text-[11px] px-2 py-0.5 font-bold" : "text-xs px-2.5 py-1 font-black";
---

<span
  class={`inline-flex items-center gap-1.5 rounded-lg border ${current.class} ${sizeClass}`}
  title={`Link health status: ${current.label}`}
>
  <span class={`h-1.5 w-1.5 rounded-full ${current.dot}`}></span>
  <span>{current.label}</span>
</span>

---
import type { VerificationStatus } from "../types/community";

interface Props {
  status: VerificationStatus;
  size?: "sm" | "md";
}

const { status, size = "md" } = Astro.props;

const config: Record<
  VerificationStatus,
  { label: string; class: string; iconPath: string }
> = {
  unverified: {
    label: "Unverified",
    class: "bg-slate-100 text-slate-600 border-slate-200",
    iconPath: "M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z",
  },
  "source-confirmed": {
    label: "Source Confirmed",
    class: "bg-sky-50 text-sky-700 border-sky-200",
    iconPath: "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z",
  },
  "owner-confirmed": {
    label: "Owner Confirmed",
    class: "bg-emerald-50 text-emerald-700 border-emerald-200",
    iconPath: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
  },
  "manually-reviewed": {
    label: "Manually Reviewed",
    class: "bg-indigo-50 text-indigo-700 border-indigo-200",
    iconPath: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4",
  },
};

const current = config[status] || config.unverified;
const sizeClass = size === "sm" ? "text-xs px-2 py-0.5" : "text-xs px-2.5 py-1 font-medium";
---

<a
  href="/how-we-verify"
  class={`inline-flex items-center gap-1 rounded-full border transition-opacity hover:opacity-85 ${current.class} ${sizeClass}`}
  title={`Verification tier: ${current.label} (Click to read verification policy)`}
>
  <svg
    class="h-3.5 w-3.5 flex-shrink-0"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d={current.iconPath}
    />
  </svg>
  <span>{current.label}</span>
</a>

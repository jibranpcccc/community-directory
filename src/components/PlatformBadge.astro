---
import type { Platform } from "../types/community";
import { getPlatformConfig } from "../config/platforms";

interface Props {
  platform: Platform;
  size?: "sm" | "md" | "lg";
  showLink?: boolean;
}

const { platform, size = "md", showLink = false } = Astro.props;
const config = getPlatformConfig(platform);

const sizeClasses = {
  sm: "px-2 py-0.5 text-[11px]",
  md: "px-2.5 py-1 text-xs",
  lg: "px-3 py-1.5 text-sm",
}[size];

const bgClasses = {
  discord: "bg-[#5865F2] text-white",
  telegram: "bg-[#0088cc] text-white",
  whatsapp: "bg-[#25D366] text-black",
}[platform] || "bg-black text-white";
---

{
  showLink ? (
    <a
      href={`/platform/${platform}/`}
      class={`inline-flex items-center font-black rounded-md border border-black shadow-[1px_1px_0px_0px_#000] hover:opacity-90 transition-opacity ${sizeClasses} ${bgClasses}`}
    >
      <span>{config ? config.name : platform}</span>
    </a>
  ) : (
    <span
      class={`inline-flex items-center font-black rounded-md border border-black shadow-[1px_1px_0px_0px_#000] ${sizeClasses} ${bgClasses}`}
    >
      <span>{config ? config.name : platform}</span>
    </span>
  )
}

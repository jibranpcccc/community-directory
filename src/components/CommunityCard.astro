---
import type { Community } from "../types/community";
import PlatformBadge from "./PlatformBadge.astro";
import CategoryBadge from "./CategoryBadge.astro";
import StatusBadge from "./StatusBadge.astro";
import VerificationBadge from "./VerificationBadge.astro";
import { formatDate } from "../lib/dates";
import { getCountryByCode } from "../config/countries";

interface Props {
  community: Community;
}

const { community } = Astro.props;
const country = getCountryByCode(community.countryCode);
---

<article class="neo-card flex flex-col justify-between p-5 bg-white">
  <div>
    <!-- Badges Row -->
    <div class="flex flex-wrap items-center justify-between gap-2 mb-3.5">
      <div class="flex flex-wrap items-center gap-1.5">
        <PlatformBadge platform={community.platform} size="sm" showLink={true} />
        {country && (
          <a
            href={`/country/${country.slug}`}
            class="rounded-md border border-black bg-[#BAE6FD] px-2 py-0.5 text-[11px] font-black text-black shadow-[1px_1px_0px_0px_#000] hover:bg-[#7DD3FC]"
          >
            {country.flag} {country.shortName}
          </a>
        )}
        <CategoryBadge category={community.category} size="sm" showLink={true} />
      </div>
      <StatusBadge status={community.linkStatus} size="sm" />
    </div>

    <!-- Title & Link -->
    <h3 class="text-lg font-black text-black hover:text-[#059669] transition-colors mb-1.5">
      <a href={`/group/${community.slug}`} class="focus:outline-none focus:underline">
        {community.title}
      </a>
    </h3>

    <!-- Location & Arrangement Info -->
    {(community.city || (community.workArrangement && community.workArrangement !== "unknown")) && (
      <div class="flex flex-wrap items-center gap-2 text-xs font-bold text-slate-700 mb-2.5">
        {community.city && (
          <span class="inline-flex items-center gap-1 text-slate-800">
            ?? {community.city}
          </span>
        )}
        {community.workArrangement && community.workArrangement !== "unknown" && (
          <span class="rounded bg-[#FEF08A] px-1.5 py-0.2 border border-black text-[10px] font-black uppercase">
            {community.workArrangement}
          </span>
        )}
      </div>
    )}

    <!-- Description (Zero AI Filler) -->
    {community.description && (
      <p class="text-xs leading-relaxed text-slate-700 font-medium line-clamp-2 mb-3">
        {community.description}
      </p>
    )}

    <!-- Tags -->
    {community.tags && community.tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mb-4">
        {community.tags.slice(0, 3).map((tag) => (
          <a
            href={`/tag/${tag.toLowerCase()}`}
            class="rounded-md border border-black bg-[#FAF8F5] px-2 py-0.5 text-[11px] font-bold text-black hover:bg-[#FEF08A] transition-colors shadow-[1px_1px_0px_0px_#000]"
          >
            #{tag}
          </a>
        ))}
      </div>
    )}
  </div>

  <!-- Footer Metadata & Actions -->
  <div class="pt-3.5 border-t-2 border-black/10 mt-2">
    <div class="flex items-center justify-between text-[11px] text-slate-600 font-bold mb-3.5">
      <div class="flex items-center gap-2">
        <VerificationBadge status={community.verificationStatus} size="sm" />
      </div>

      {community.lastCheckedAt && (
        <span title={`Last link check: ${community.lastCheckedAt}`} class="text-slate-500 font-medium">
          Checked {formatDate(community.lastCheckedAt)}
        </span>
      )}
    </div>

    <!-- Sourced Member Count (Only shown if genuinely verified from source) -->
    {typeof community.memberCount === "number" && community.memberCountSource && (
      <div class="text-xs text-black font-bold mb-3">
        ?? <strong>{community.memberCount.toLocaleString()}</strong> observed members
      </div>
    )}

    <!-- Action Buttons -->
    <div class="grid grid-cols-2 gap-2.5">
      <a
        href={`/group/${community.slug}`}
        class="neo-btn text-center bg-white hover:bg-slate-100 text-black px-3 py-2 text-xs font-black border-2 border-black shadow-[2px_2px_0px_0px_#000]"
      >
        View Details
      </a>
      <a
        href={community.inviteUrl}
        target="_blank"
        rel="nofollow noopener noreferrer"
        class="neo-btn text-center inline-flex items-center justify-center bg-[#A7F3D0] hover:bg-[#6EE7B7] text-black px-3 py-2 text-xs font-black border-2 border-black shadow-[2px_2px_0px_0px_#000]"
        aria-label={`Join ${community.title} on ${community.platform} (opens in a new tab)`}
      >
        <span>Join on {community.platform === "discord" ? "Discord" : community.platform === "telegram" ? "Telegram" : "WhatsApp"}</span>
      </a>
    </div>
  </div>
</article>

# Public Site URL (Used for Canonical URLs, Open Graph, and Sitemap generation)
PUBLIC_SITE_URL=http://localhost:4321

# Google Gemini API Key (Required ONLY for running "npm run discover")
# Get an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Gemini Model Selection (e.g. gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Enable Google Search Grounding for discovery
GEMINI_SEARCH_ENABLED=true

# Discovery Limits and Budget Controls
DISCOVERY_MAX_QUERIES=30
DISCOVERY_MAX_CANDIDATES=100
DISCOVERY_REQUEST_DELAY_MS=1200

# Auto-publish directly to groups.json (default: false -> writes to pending-groups.json for review)
AUTO_PUBLISH_DISCOVERED=false

# Optional UI placeholders for future sponsorship/ads
SHOW_AD_PLACEHOLDERS=false

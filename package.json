{
  "name": "community-directory",
  "type": "module",
  "version": "1.0.0",
  "description": "Production-ready automated directory website for discovering and cataloguing public online communities",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate-data": "tsx scripts/data/validateSchema.ts",
    "data:stats": "tsx scripts/utilities/stats.ts",
    "discover": "tsx scripts/discover/index.ts",
    "auto-publish": "tsx scripts/data/autoPublish.ts",
    "revalidate-published": "tsx scripts/data/revalidatePublished.ts",
    "validate-links": "tsx scripts/validate/index.ts",
    "approve": "tsx scripts/utilities/approve.ts",
    "seo:audit": "tsx scripts/seo/auditBuild.ts",
    "indexnow": "tsx scripts/seo/notifyIndexNow.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.1",
    "@astrojs/tailwind": "^5.1.5",
    "@google/generative-ai": "^0.24.0",
    "astro": "^5.3.0",
    "tailwindcss": "^3.4.17",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
